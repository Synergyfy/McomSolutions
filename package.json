{
  "name": "mcom-solutions-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:frontend": "node init && npm run dev --workspace=apps/frontend",
    "dev:backend": "node init && npm run start:dev --workspace=apps/backend",
    "dev": "node init && concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "node init && npm run build --workspace=apps/frontend",
    "build:backend": "node init && npm run build --workspace=apps/backend",
    "build": "node init && npm run build:frontend && npm run build:backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2"
  }
}
