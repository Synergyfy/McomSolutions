# DEPRECATED (Phase 7): Gemini-applet era leftover — kept only so old references
# don't break. Do NOT add new variables here. The real templates are:
#   - backend:  apps/backend/.env.example
#   - frontend: apps/frontend/.env.example (VITE_* variables)
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database connection URL (Uncomment and set to connect to Supabase)
# DATABASE_URL="postgresql://postgres:password@db.oyvjdbekepvurmfsmomm.supabase.co:5432/postgres"

# SMTP Email Configuration (Optional, falls back to logging if not set)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Central Hub Solution <no-reply@centralhubsolution.com>"

# ─── Stripe Payment Configuration ────────────────────────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── PayPal Payment Configuration ────────────────────────────────────────────
# Get these from: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
# Use 'sandbox' for testing, 'live' for production
PAYPAL_ENV="sandbox"
# Webhook id from the PayPal app used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=""

# ─── Recurring Billing ───────────────────────────────────────────────────────
# Master switch for opt-in auto-renew mandates.
RECURRING_PAYMENTS_ENABLED="true"
# Set false to run in shadow mode (no cron processing).
RENEWAL_CRON_ENABLED="true"
# Days of grace after a failed renewal before access is revoked.
RENEWAL_GRACE_DAYS="3"

# ─── HMAC Service-to-Service Auth (Data Sharing API) ────────────────────────
# Shared fallback secret used by all partner services to sign HMAC requests.
# Alternatively, set per-service secrets individually (see below).
SSO_API_SECRET="your-hmac-shared-secret"

# Per-service HMAC secrets (override SSO_API_SECRET for specific services):
# MCOM_MALL_SECRET="mall-hmac-secret"
# MCOM_REWARDS_SECRET="rewards-hmac-secret"
# MCOM_SPIN_SECRET="spin-hmac-secret"
# MCOM_AUDIT_SECRET="audit-hmac-secret"
# MCOM_EXPO_SECRET="expo-hmac-secret"

# ─── Ecosystem Service-to-Service Identity (M2M / JWKS) ──────────────────────
# MCOM signs short-lived RS256 service tokens with a private key; partner apps
# verify them OFFLINE using the published public JWKS. Registered app backends
# then call each other directly — MCOM is never in the request path.
#
# Generate a keypair once (do NOT commit the private key):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out service.key
#   openssl rsa -in service.key -pubout -out service.pub
# Paste the PEM contents with literal newlines (or use \n escapes).
SERVICE_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SERVICE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Key id published in the JWKS + JWT header. Bump when rotating.
SERVICE_JWT_KID="mcom-svc-1"
# Issuer claim (must match what partner verifiers expect).
SERVICE_JWT_ISSUER="mcom-solutions"
# Access-token lifetime in seconds (keep short — revocation window).
SERVICE_TOKEN_TTL_SECONDS="300"

