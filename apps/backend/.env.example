# ─── MCOM Solutions Backend — Environment Template ────────────────────────────
# Copy to .env and fill in real values. NEVER commit real secrets.

JWT_SECRET="change-me"
# Phase 3: SSO audience uses its own secret (strictly separated from JWT_SECRET).
# Required in every environment (boot fails closed); no JWT_SECRET fallback.
# Generate with: openssl rand -hex 32
SSO_JWT_SECRET="change-me-sso"
# Phase 3 (G4): spec access TTL is 15m. Accepts "15m", "1h", or seconds ("900").
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
APP_URL="http://localhost:3010"
FRONTEND_URL="http://localhost:3000"
DATABASE_URL="postgresql://user:pass@host:5432/mcom_solutions"
DIRECT_URL="postgresql://user:pass@host:5432/mcom_solutions"

MOCK_OTP=true
# HMAC pepper for hashing OTP / password-reset codes stored in Redis.
# Required in production (boot fails closed); non-prod falls back to JWT_SECRET.
# Generate with: openssl rand -hex 32
OTP_PEPPER=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Central Hub Solution <no-reply@centralhubsolution.com>"
# Transactional email via Resend (used for OTP / password-reset codes).
# Falls back to the SMTP_* vars above when not set.
RESEND_API_KEY=""

# ─── Payment (use test keys in dev/staging) ───────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# ─── Centralized Wallet ───────────────────────────────────────────────────────
WALLET_MAX_SINGLE_TXN=10000
WALLET_DEFAULT_DAILY_LIMIT=50000
WALLET_HOLD_DEFAULT_TTL_HOURS=24

# ─── Google ───────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""
# Required for real Google Sign-In / business claim (Google OAuth). If left empty,
# the endpoints return 503 unless GOOGLE_OAUTH_SIMULATOR=true in non-production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# HMAC key used to sign OAuth `state` so it cannot be forged. Falls back to JWT_SECRET.
GOOGLE_OAUTH_STATE_SECRET=""
# DEVELOPMENT ONLY — enables the Google login/claim simulators. Ignored in production.
GOOGLE_OAUTH_SIMULATOR=false

# ─── MCOM Service-to-Service HMAC Secrets ────────────────────────────────────
SSO_API_SECRET=""
MCOM_REWARDS_SECRET=""
MCOM_SPIN_SECRET=""
MCOM_MALL_SECRET=""
MCOM_AUDIT_SECRET=""
MCOM_EXPO_SECRET=""

# ─── External Service Connectors ─────────────────────────────────────────────
MCOM_MALL_API_URL=""
MCOM_REWARDS_API_URL=""
MCOM_SOLUTION_API_KEY=""
MCOM_REWARDS_API_KEY=""

# ─── Redis Configuration ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# ─── Query Observability ───────────────────────────────────────────────────
# Slow-query warn threshold in ms (Prisma operations slower than this log a
# warning with model + operation + duration only — never query args). Default 100.
SLOW_QUERY_MS="100"

# ─── Mcom Console Encryption ──────────────────────────────────────────────────
# AES-256-GCM key used to encrypt SsoClient.hmacSecret and webhookSecret.
# Generate with: openssl rand -hex 32
CONSOLE_ENCRYPTION_KEY=""

# ─── SSO Seed Clients (Phase 1A — insert-only, env-sourced) ─────────────────
# The backend never ships hardcoded SSO secrets. Set these in staging/production
# before first boot so the insert-only seeder can provision clients.
# Production fails closed when a required value is missing.
# Generate with: openssl rand -hex 32
SSO_SEED_MALL_CLIENT_SECRET=""
SSO_SEED_MALL_API_KEY=""
SSO_SEED_MALL_HMAC_SECRET=""
SSO_SEED_MALL_WEBHOOK_SECRET=""
SSO_SEED_247GBS_CLIENT_SECRET=""
SSO_SEED_247GBS_API_KEY=""
SSO_SEED_247GBS_AFFILIATE_CLIENT_SECRET=""
SSO_SEED_247GBS_AFFILIATE_API_KEY=""

# ─── Server ───────────────────────────────────────────────────────────────────
PORT="3010"

# ─── SSO Token Lifetimes (Phase 7 — previously undocumented) ────────────────
# Auth codes: seconds (default 300). Access/refresh: seconds (defaults shown).
SSO_CODE_TTL_SECONDS="300"
SSO_ACCESS_TOKEN_TTL="3600"
SSO_REFRESH_TOKEN_TTL="604800"
# Issuer claim stamped on centrally-issued tokens (default "mcom-central").
MCOM_CENTRAL_ISSUER="mcom-central"

# ─── FX Fallback Rate (Phase 7 — previously undocumented) ────────────────────
# Used only when no admin FxRate row applies. Format: "<FROM>_<TO>=<rate>".
MCOM_GBP_RATE=""

# ─── Wallet Notifications (Phase 7 — previously undocumented) ───────────────
# Debits at or above this amount (minor units) raise a warning notification.
WALLET_NOTIFY_DEBIT_THRESHOLD=""

# ─── Cloudinary Uploads (Phase 7 — previously undocumented) ─────────────────
# Server-side signed uploads (business + admin catalog controllers).
# CLOUDINARY_CLOUD_NAME also honours NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME as fallback.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""