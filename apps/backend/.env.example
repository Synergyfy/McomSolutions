# ─── MCOM Solutions Backend — Environment Template ────────────────────────────
# Copy to .env and fill in real values. NEVER commit real secrets.

JWT_SECRET="change-me"
APP_URL="http://localhost:3010"
FRONTEND_URL="http://localhost:3000"
DATABASE_URL="postgresql://user:pass@host:5432/mcom_solutions"
DIRECT_URL="postgresql://user:pass@host:5432/mcom_solutions"

MOCK_OTP=true
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@mcomsolutions.com"
# Transactional email via Resend (used for OTP / password-reset codes).
# Falls back to the SMTP_* vars above when not set.
RESEND_API_KEY=""

# ─── Payment (use test keys in dev/staging) ───────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# ─── Centralized Wallet ───────────────────────────────────────────────────────
WALLET_MAX_SINGLE_TXN=10000
WALLET_DEFAULT_DAILY_LIMIT=50000
WALLET_HOLD_DEFAULT_TTL_HOURS=24

# ─── Google ───────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""
# Required for real Google Sign-In / business claim (Google OAuth). If left empty,
# the endpoints return 503 unless GOOGLE_OAUTH_SIMULATOR=true in non-production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# HMAC key used to sign OAuth `state` so it cannot be forged. Falls back to JWT_SECRET.
GOOGLE_OAUTH_STATE_SECRET=""
# DEVELOPMENT ONLY — enables the Google login/claim simulators. Ignored in production.
GOOGLE_OAUTH_SIMULATOR=false

# ─── MCOM Service-to-Service HMAC Secrets ────────────────────────────────────
SSO_API_SECRET=""
MCOM_REWARDS_SECRET=""
MCOM_SPIN_SECRET=""
MCOM_MALL_SECRET=""
MCOM_AUDIT_SECRET=""
MCOM_EXPO_SECRET=""

# ─── External Service Connectors ─────────────────────────────────────────────
MCOM_MALL_API_URL=""
MCOM_REWARDS_API_URL=""
MCOM_SOLUTION_API_KEY=""
MCOM_REWARDS_API_KEY=""

# ─── Redis Configuration ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# ─── Mcom Console Encryption ──────────────────────────────────────────────────
# AES-256-GCM key used to encrypt SsoClient.hmacSecret and webhookSecret.
# Generate with: openssl rand -hex 32
CONSOLE_ENCRYPTION_KEY=""