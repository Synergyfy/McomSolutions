// ─── CENTRALIZED WALLET SYSTEM ────────────────────────────────────────────────

enum WalletStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionCategory {
  TOP_UP
  REWARD
  REFUND
  ADMIN_CREDIT
  TRANSFER_IN
  SUBSCRIPTION
  PURCHASE
  SERVICE_FEE
  ADMIN_DEBIT
  TRANSFER_OUT
  HOLD_CAPTURE
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REVERSED
}

enum HoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

enum TopUpStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Wallet {
  id       String       @id @default(cuid())
  userId   String       @unique @map("user_id")
  balance  Decimal      @default(0) @map("balance") @db.Decimal(18, 4)
  currency String       @default("MCOM") @map("currency")
  status   WalletStatus @default(ACTIVE) @map("status")

  dailyDebitLimit   Decimal? @map("daily_debit_limit") @db.Decimal(18, 4)
  monthlyDebitLimit Decimal? @map("monthly_debit_limit") @db.Decimal(18, 4)
  maxBalance        Decimal? @map("max_balance") @db.Decimal(18, 4)

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastTransactionAt DateTime? @map("last_transaction_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
  holds         WalletHold[]
  topUpRequests WalletTopUpRequest[]
  auditLogs     WalletAuditLog[]

  @@index([userId])
  @@index([status])
  @@map("wallets")
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String @map("wallet_id")

  type          TransactionType @map("type")
  amount        Decimal         @map("amount") @db.Decimal(18, 4)
  balanceBefore Decimal         @map("balance_before") @db.Decimal(18, 4)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(18, 4)
  currency      String          @default("MCOM") @map("currency")

  platformClientId String? @map("platform_client_id")
  platformName     String? @map("platform_name")
  platformSlug     String? @map("platform_slug")

  category    TransactionCategory @map("category")
  reference   String?             @map("reference")
  description String?             @map("description")
  metadata    Json?               @map("metadata")

  idempotencyKey String? @unique @map("idempotency_key")

  status        TransactionStatus @default(COMPLETED) @map("status")
  failureReason String?           @map("failure_reason")
  holdId        String?           @map("hold_id")
  initiatedBy   String?           @map("initiated_by")
  ipAddress     String?           @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  hold   WalletHold? @relation(fields: [holdId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([walletId, createdAt(sort: Desc)])
  @@index([platformClientId])
  @@index([platformSlug])
  @@index([category])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([idempotencyKey])
  @@index([reference])
  @@index([status])
  @@index([walletId, platformSlug, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model WalletHold {
  id               String     @id @default(cuid())
  walletId         String     @map("wallet_id")
  amount           Decimal    @map("amount") @db.Decimal(18, 4)
  platformClientId String     @map("platform_client_id")
  platformName     String     @map("platform_name")
  reference        String?    @map("reference")
  description      String?    @map("description")
  status           HoldStatus @default(ACTIVE) @map("status")
  expiresAt        DateTime   @map("expires_at")
  capturedAt       DateTime?  @map("captured_at")
  releasedAt       DateTime?  @map("released_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  wallet       Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([walletId])
  @@index([platformClientId])
  @@index([expiresAt])
  @@index([status])
  @@index([status, expiresAt])
  @@map("wallet_holds")
}

model WalletAuditLog {
  id        String   @id @default(cuid())
  walletId  String   @map("wallet_id")
  adminId   String   @map("admin_id")
  action    String   @map("action")
  reason    String   @map("reason")
  changes   Json?    @map("changes")
  ip        String?  @map("ip")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([adminId])
  @@index([createdAt(sort: Desc)])
  @@map("wallet_audit_logs")
}

model WalletTopUpRequest {
  id             String  @id @default(cuid())
  walletId       String  @map("wallet_id")
  userId         String  @map("user_id")
  amount         Decimal @map("amount") @db.Decimal(18, 4)
  currency       String  @default("GBP") @map("currency")
  walletCurrency String  @default("MCOM") @map("wallet_currency")
  exchangeRate   Decimal @default(1) @map("exchange_rate") @db.Decimal(10, 6)

  provider       String  @map("provider")
  providerRef    String? @unique @map("provider_ref")
  providerStatus String? @map("provider_status")

  status        TopUpStatus @default(PENDING) @map("status")
  transactionId String?     @map("transaction_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([providerRef])
  @@index([status])
  @@map("wallet_top_up_requests")
}

// ─── FX RATES (wallet top-up conversion) ────────────────────────────────────
// Base → quote pair, seeded from env (MCOM_GBP_RATE) and updatable at runtime.

model FxRate {
  id        String   @id @default(cuid())
  base      String   @map("base") // e.g. 'GBP'
  quote     String   @map("quote") // e.g. 'MCOM'
  rate      Decimal  @map("rate") @db.Decimal(10, 6)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([base, quote])
  @@map("fx_rates")
}

// ─── PROGRAMME & SYSTEM SETTINGS ────────────────────────────────────────────

model ProgrammeSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("programme_settings")
}

// ─── RELATIONAL PLAN FAMILY & TIER ARCHITECTURE — REMOVED ──────────────────────
// MCOM holds no plans of its own (memberships-only model). Memberships
// (membership_plans) bundle plans/packages that live on console-registered
// external platforms (see admin/console + external_plans mirror). The former
// Tier/Plan/PlanVariant/PlanPrice/Subscription tables were dropped in
// migration 20261006030000_drop_tier_plan_package_tables; tiers survive as
// Standard/Pro/Pro+ values in tier* JSON columns and tier-duration utils.

// ─── ENTERPRISE REAL-TIME CHAT & MESSAGING SYSTEM ────────────────────────────

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

model Conversation {
  id                  String           @id @default(uuid())
  type                ConversationType @default(DIRECT)
  title               String? // For group conversations
  avatarUrl           String?          @map("avatar_url")
  directKey           String?          @unique @map("direct_key") // canonical sorted "userIdA:userIdB"
  createdById         String?          @map("created_by_id")
  createdBy           User?            @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastMessageAt       DateTime         @default(now()) @map("last_message_at")
  lastMessageText     String?          @map("last_message_text")
  lastMessageSenderId String?          @map("last_message_sender_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@index([deletedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id                String          @id @default(uuid())
  conversationId    String          @map("conversation_id")
  conversation      Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              ParticipantRole @default(MEMBER)
  isMuted           Boolean         @default(false) @map("is_muted")
  lastReadMessageId String?         @map("last_read_message_id")
  lastReadAt        DateTime?       @map("last_read_at")
  joinedAt          DateTime        @default(now()) @map("joined_at")
  leftAt            DateTime?       @map("left_at")

  @@unique([conversationId, userId])
  @@index([userId, isMuted])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  idempotencyKey String?      @map("idempotency_key")
  type           String       @default("TEXT") // TEXT, SYSTEM, IMAGE, FILE
  content        String       @db.Text
  metadata       Json?
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  readReceipts MessageReadReceipt[]

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now()) @map("read_at")

  @@unique([messageId, userId])
  @@index([messageId, readAt])
  @@index([userId])
  @@map("message_read_receipts")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  directMessages Boolean  @default(true) @map("direct_messages")
  groupMessages  Boolean  @default(true) @map("group_messages")
  pushEnabled    Boolean  @default(true) @map("push_enabled")
  emailEnabled   Boolean  @default(true) @map("email_enabled")
  dndEnabled     Boolean  @default(false) @map("dnd_enabled")
  dndStartTime   String?  @map("dnd_start_time")
  dndEndTime     String?  @map("dnd_end_time")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model ChatOutbox {
  id           String    @id @default(uuid())
  eventType    String    @map("event_type") // NEW_MESSAGE, PUSH_DISPATCH, READ_SYNC
  payload      Json
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  retryCount   Int       @default(0) @map("retry_count")
  errorMessage String?   @map("error_message")
  processedAt  DateTime? @map("processed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("chat_outbox")
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ChatMessageRequest {
  id             String               @id @default(uuid())
  senderId       String               @map("sender_id")
  sender         User                 @relation("MessageRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String               @map("receiver_id")
  receiver       User                 @relation("MessageRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  status         MessageRequestStatus @default(PENDING)
  message        String?              @db.Text
  rejectionCount Int                  @default(0) @map("rejection_count")
  respondedAt    DateTime?            @map("responded_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("chat_message_requests")
}

model ChatBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blocker   User     @relation("UserBlocksSent", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id")
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("chat_blocks")
}

// ─── PARTNER (MESH PEER) GRANTS ──────────────────────────────────────────────
// Durable record of a grant issued by a partner app (e.g. MCOM Rewards) into
// Central. `(sourceApp, issuanceId)` is the idempotency key — replays return the
// same row instead of creating a second membership/code/coupon.
enum PartnerGrantKind {
  MEMBERSHIP
  ACCESS_PASS
}

enum PartnerGrantStatus {
  GRANTED
  REVOKED
  EXPIRED
  FAILED
}

model PartnerGrant {
  id                String             @id @default(cuid())
  issuanceId        String             @map("issuance_id")
  sourceApp         String             @map("source_app")
  callerClientId    String             @map("caller_client_id")
  kind              PartnerGrantKind
  businessId        String?            @map("business_id")
  planId            String             @map("plan_id")
  tier              String?
  durationDays      Int?               @map("duration_days")
  status            PartnerGrantStatus @default(GRANTED)
  providerPaymentId String?            @map("provider_payment_id")
  accessPassCodeId  String?            @map("access_pass_code_id")
  expiresAt         DateTime?          @map("expires_at")
  expiryNotifiedAt  DateTime?          @map("expiry_notified_at")
  metadata          Json?              @map("metadata")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([sourceApp, issuanceId])
  @@index([businessId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([callerClientId])
  @@map("partner_grants")
}

// Append-only audit for every partner API mutation (caller, scope, target,
// idempotency key, outcome). Best-effort writes never block the response.
model PartnerAuditLog {
  id             String   @id @default(cuid())
  callerClientId String   @map("caller_client_id")
  scope          String?  @map("scope")
  action         String   @map("action")
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  issuanceId     String?  @map("issuance_id")
  outcome        String   @map("outcome") // success | error
  statusCode     Int?     @map("status_code")
  errorCode      String?  @map("error_code")
  metadata       Json?    @map("metadata")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([callerClientId])
  @@index([issuanceId])
  @@index([createdAt])
  @@map("partner_audit_logs")
}

// ─── AFFILIATE COLLABORATION (account managers, delegated tasks, reputation) ──
// Businesses on a paid membership are assigned an account manager by proximity
// (postcode → city/borough/high-street/local-mall) and reputation score. Tasks
// can then be delegated to that account manager, or — for trial/access-pass
// businesses with no account manager — to any nearby agent/consultant/account
// manager chosen by the business or assigned by an admin. Execution happens in
// the 247GBS Affiliates backend (backend-to-backend); review + reputation stays
// here in Central.

enum AffiliateTaskStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  PENDING_BUSINESS_APPROVAL
  REVISION_REQUESTED
  COMPLETED
  DECLINED
  CANCELLED
}

enum AffiliateTaskSource {
  PROGRAMME
  MANUAL
}

enum AffiliateTaskCategory {
  INTERNAL
  EXTERNAL
}

enum AffiliateCompensationModel {
  NONE
  FIXED
  HOURLY
  COMMISSION
  MEMBERSHIP_INCLUDED
}

enum AffiliatePaymentStatus {
  NOT_APPLICABLE
  PENDING
  ELIGIBLE
  PAID
  ON_HOLD
}

enum AffiliateChargeStatus {
  NOT_APPLICABLE
  PENDING_APPROVAL
  APPROVED
  DECLINED
  CHARGED
  WAIVED
}

enum AffiliateProjectStatus {
  ACTIVE
  ON_HOLD
  AWAITING_BUSINESS_APPROVAL
  COMPLETED
  CANCELLED
}

enum AffiliateServiceRequestStatus {
  SUBMITTED
  CLARIFICATION_REQUIRED
  APPROVED
  CONVERTED
  COMPLETED
  REJECTED
}

enum AffiliateReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum AffiliateRatingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AffiliateReportStatus {
  PENDING
  VALID
  INVALID
}

// Escrow lifecycle for a delegated task's money:
//   NOT_REQUIRED → nothing to hold or pay
//   PENDING_HOLD → assignment priced, hold not yet confirmed
//   HELD         → business funds are reserved (or platform-backed payout)
//   SETTLING     → hold captured / payout in progress
//   SETTLED      → business debited, affiliate credited, platform fee booked
//   RELEASED     → hold returned to the business (cancel / decline)
//   FAILED       → needs admin attention; never silently dropped
enum AffiliateSettlementStatus {
  NOT_REQUIRED
  PENDING_HOLD
  HELD
  SETTLING
  SETTLED
  RELEASED
  FAILED
}

// Who funds the affiliate payout. Active paid memberships never have their
// wallet charged again, so the platform absorbs the cost.
enum AffiliateSettlementFunding {
  BUSINESS_WALLET
  PLATFORM
}

// Immutable-ish audit row for one task's money movement. The wallet ledger
// (WalletTransaction) remains the source of truth for balances; this row
// links the business debit, the affiliate credit and the platform fee together
// so every penny can be reconciled.
model AffiliateTaskSettlement {
  id                     String                      @id @default(cuid())
  taskId                 String                      @unique @map("task_id")
  task                   AffiliateTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  businessId             String                      @map("business_id")
  businessUserId         String                      @map("business_user_id")
  affiliateUserId        String?                     @map("affiliate_user_id")
  affiliateEmail         String?                     @map("affiliate_email")

  // Source prices are in the task currency (normally GBP); credits are what
  // actually moves in the MCOM wallet.
  currency               String                      @default("GBP") @map("currency")
  fxBase                 String                      @default("GBP") @map("fx_base")
  fxQuote                String                      @default("MCOM") @map("fx_quote")
  fxRate                 Decimal                     @default(1) @map("fx_rate") @db.Decimal(18, 6)

  businessChargeAmount   Decimal?                    @map("business_charge_amount") @db.Decimal(18, 4)
  businessChargeCredits  Decimal?                    @map("business_charge_credits") @db.Decimal(18, 4)
  compensationAmount     Decimal?                    @map("compensation_amount") @db.Decimal(18, 4)
  // Exact integer source amount in pence (GBP minor units).
  compensationPence      Int?                        @map("compensation_pence")
  compensationCredits    Decimal?                    @map("compensation_credits") @db.Decimal(18, 4)
  platformFeePercent     Decimal                     @default(0) @map("platform_fee_percent") @db.Decimal(7, 4)
  platformFeeCredits     Decimal                     @default(0) @map("platform_fee_credits") @db.Decimal(18, 4)
  // The charge-minus-payout spread that stays with the platform on top of the
  // explicit percentage fee. Together they make gross = payout + fee + margin.
  platformMarginCredits  Decimal                     @default(0) @map("platform_margin_credits") @db.Decimal(18, 4)
  affiliatePayoutCredits Decimal                     @default(0) @map("affiliate_payout_credits") @db.Decimal(18, 4)

  fundingSource          AffiliateSettlementFunding  @default(BUSINESS_WALLET) @map("funding_source")
  status                 AffiliateSettlementStatus   @default(NOT_REQUIRED) @map("status")

  holdId                 String?                     @unique @map("hold_id")
  holdExpiresAt          DateTime?                   @map("hold_expires_at")
  businessTransactionId  String?                     @map("business_transaction_id")
  affiliateTransactionId String?                     @map("affiliate_transaction_id")
  settlementReference    String?                     @unique @map("settlement_reference")
  failureReason          String?                     @map("failure_reason")
  metadata               Json?                       @map("metadata")

  heldAt                 DateTime?                   @map("held_at")
  settledAt              DateTime?                   @map("settled_at")
  releasedAt             DateTime?                   @map("released_at")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([businessUserId])
  @@index([affiliateUserId])
  @@index([status])
  @@index([fundingSource])
  @@index([createdAt])
  @@index([settledAt])
  @@map("affiliate_task_settlements")
}

// A project groups related tasks that deliver one business outcome
// (e.g. "New Product Collection Launch"). It is the Account Manager's service
// plan and the unit the business closes out / follows up on.
model AffiliateProject {
  id                       String                   @id @default(cuid())
  businessId               String                   @map("business_id")
  business                 BusinessProfile          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceRequestId         String?                  @unique @map("service_request_id")
  serviceRequest           AffiliateServiceRequest? @relation("ServiceRequestProject", fields: [serviceRequestId], references: [id], onDelete: SetNull)
  accountManagerId         String?                  @map("account_manager_id")
  accountManager           User?                    @relation("AffiliateProjectManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  createdByUserId          String                   @map("created_by_user_id")
  createdBy                User                     @relation("AffiliateProjectCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  title                    String                   @map("title")
  description              String                   @map("description") @db.Text
  objective                String?                  @map("objective") @db.Text
  status                   AffiliateProjectStatus   @default(ACTIVE) @map("status")
  dueAt                    DateTime?                @map("due_at")
  requiresBusinessApproval Boolean                  @default(false) @map("requires_business_approval")
  businessApprovedAt       DateTime?                @map("business_approved_at")
  businessApprovedByUserId String?                  @map("business_approved_by_user_id")
  closedAt                 DateTime?                @map("closed_at")
  outcomeSummary           String?                  @map("outcome_summary") @db.Text
  followUpRequired         Boolean                  @default(false) @map("follow_up_required")
  followUpNotes            String?                  @map("follow_up_notes") @db.Text
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  tasks AffiliateTask[]

  @@index([businessId])
  @@index([accountManagerId])
  @@index([status])
  @@index([createdAt])
  @@map("affiliate_projects")
}

// The business's initial ask. The Account Manager clarifies it, then converts
// it into a project and one or more tasks.
model AffiliateServiceRequest {
  id                    String                        @id @default(cuid())
  businessId            String                        @map("business_id")
  business              BusinessProfile               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedByUserId     String                        @map("requested_by_user_id")
  requestedBy           User                          @relation("AffiliateServiceRequestCreator", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  accountManagerId      String?                       @map("account_manager_id")
  accountManager        User?                         @relation("AffiliateServiceRequestManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  title                 String                        @map("title")
  description           String                        @map("description") @db.Text
  desiredOutcome        String?                       @map("desired_outcome") @db.Text
  urgency               String                        @default("NORMAL") @map("urgency")
  status                AffiliateServiceRequestStatus @default(SUBMITTED) @map("status")
  clarificationNote     String?                       @map("clarification_note") @db.Text
  estimatedCost         Float?                        @map("estimated_cost")
  currency              String                        @default("GBP") @map("currency")
  priceApprovedAt       DateTime?                     @map("price_approved_at")
  priceApprovedByUserId String?                       @map("price_approved_by_user_id")
  approvedAt            DateTime?                     @map("approved_at")
  rejectedReason        String?                       @map("rejected_reason") @db.Text
  closedAt              DateTime?                     @map("closed_at")
  followUpNotes         String?                       @map("follow_up_notes") @db.Text
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")

  project AffiliateProject? @relation("ServiceRequestProject")

  @@index([businessId])
  @@index([accountManagerId])
  @@index([status])
  @@index([createdAt])
  @@map("affiliate_service_requests")
}

// Append-only audit timeline for a task. Covers assignment, acceptance,
// submissions, AM checks, business approvals, payment and follow-up.
model AffiliateTaskEvent {
  id          String        @id @default(cuid())
  taskId      String        @map("task_id")
  task        AffiliateTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorUserId String?       @map("actor_user_id")
  actor       User?         @relation("AffiliateTaskEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole   String?       @map("actor_role")
  type        String        @map("type")
  message     String?       @map("message") @db.Text
  metadata    Json?         @map("metadata")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@index([type])
  @@map("affiliate_task_events")
}

model AffiliateTask {
  id                             String                     @id @default(cuid())
  businessId                     String                     @map("business_id")
  business                       BusinessProfile            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source                         AffiliateTaskSource        @default(MANUAL) @map("source")
  // Optional link to an admin-authored programme task that the business pushed.
  taskDefinitionId               String?                    @map("task_definition_id")
  taskDefinition                 TaskDefinition?            @relation(fields: [taskDefinitionId], references: [id], onDelete: SetNull)
  // The business programme assignment this delegation was pushed from. Used to
  // mark the task "Delegated" and prevent duplicate delegation.
  sourceAssignmentId             String?                    @map("source_assignment_id")
  // Optional project grouping (Account Manager's service plan).
  projectId                      String?                    @map("project_id")
  project                        AffiliateProject?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Internal = platform/operational execution. External = creative,
  // professional or specialist service delivered outside the platform.
  category                       AffiliateTaskCategory      @default(EXTERNAL) @map("category")
  title                          String                     @map("title")
  description                    String                     @map("description") @db.Text
  // Platform tags the affiliate may work under (e.g. "mcom_mall", "mcom_rewards").
  platforms                      String[]                   @default([]) @map("platforms")
  requiredSkills                 String[]                   @default([]) @map("required_skills")
  // Agreed deliverable, supplied materials and the task that must finish first
  // (e.g. banner design → banner publication).
  deliverables                   String?                    @map("deliverables") @db.Text
  materials                      String?                    @map("materials") @db.Text
  prerequisiteTaskId             String?                    @map("prerequisite_task_id")
  prerequisiteTask               AffiliateTask?             @relation("AffiliateTaskPrerequisite", fields: [prerequisiteTaskId], references: [id], onDelete: SetNull)
  dependentTasks                 AffiliateTask[]            @relation("AffiliateTaskPrerequisite")
  status                         AffiliateTaskStatus        @default(PENDING_ASSIGNMENT) @map("status")
  // Assigned affiliate (agent / account manager / consultant). Nullable while
  // an admin needs to route a trial/access-pass request.
  assigneeId                     String?                    @map("assignee_id")
  assignee                       User?                      @relation("AffiliateTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeRole                   Role?                      @map("assignee_role")
  assignedByAdminId              String?                    @map("assigned_by_admin_id")
  assignedByAdmin                User?                      @relation("AffiliateTaskAssignedByAdmin", fields: [assignedByAdminId], references: [id], onDelete: SetNull)
  createdByUserId                String                     @map("created_by_user_id")
  createdBy                      User                       @relation("AffiliateTaskCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  dueAt                          DateTime?                  @map("due_at")
  // Mirror id + sync state for the 247GBS Affiliates task record.
  affiliateTaskId                String?                    @map("affiliate_task_id")
  lastSyncAt                     DateTime?                  @map("last_sync_at")
  lastSyncError                  String?                    @map("last_sync_error")
  // Structured submission from the affiliate (notes, links[], attachments[]).
  submissionData                 Json?                      @map("submission_data")
  revisionCount                  Int                        @default(0) @map("revision_count")
  acceptedAt                     DateTime?                  @map("accepted_at")
  // ── Review & approval ──
  // Account Manager checks the submission before it reaches the business.
  amReviewedAt                   DateTime?                  @map("am_reviewed_at")
  amReviewedByUserId             String?                    @map("am_reviewed_by_user_id")
  amReviewNotes                  String?                    @map("am_review_notes") @db.Text
  // Business acceptance is only required when the task/outcome needs it.
  requiresBusinessApproval       Boolean                    @default(false) @map("requires_business_approval")
  businessApprovedAt             DateTime?                  @map("business_approved_at")
  businessApprovedByUserId       String?                    @map("business_approved_by_user_id")
  businessApprovalNotes          String?                    @map("business_approval_notes") @db.Text
  // ── Compensation & business charge (kept deliberately separate) ──
  compensationModel              AffiliateCompensationModel @default(NONE) @map("compensation_model")
  compensationAmount             Float?                     @map("compensation_amount")
  // Authoritative integer amount (minor units / pence) used for exact money
  // calculations. compensationAmount remains for display/backwards compatibility.
  compensationPence              Int?                       @map("compensation_pence")
  compensationCurrency           String                     @default("GBP") @map("compensation_currency")
  billableToBusiness             Boolean                    @default(false) @map("billable_to_business")
  businessChargeAmount           Float?                     @map("business_charge_amount")
  businessChargeCurrency         String                     @default("GBP") @map("business_charge_currency")
  businessChargeStatus           AffiliateChargeStatus      @default(NOT_APPLICABLE) @map("business_charge_status")
  businessChargeApprovedAt       DateTime?                  @map("business_charge_approved_at")
  businessChargeApprovedByUserId String?                    @map("business_charge_approved_by_user_id")
  paymentStatus                  AffiliatePaymentStatus     @default(NOT_APPLICABLE) @map("payment_status")
  paidAt                         DateTime?                  @map("paid_at")
  settlementReference            String?                    @map("settlement_reference")
  earningsRecordedAt             DateTime?                  @map("earnings_recorded_at")
  // ── Free delegation quota (membership / access-pass allowance) ──
  // null = not evaluated yet; false = quota exhausted, this task is chargeable.
  freeDelegation                 Boolean?                   @map("free_delegation")
  delegationQuotaSource          String?                    @map("delegation_quota_source") // MEMBERSHIP | ACCESS_PASS | NONE
  delegationQuotaLimit           Int?                       @map("delegation_quota_limit")
  delegationQuotaUsed            Int?                       @map("delegation_quota_used")
  delegationQuotaUnlimited       Boolean?                   @map("delegation_quota_unlimited")
  delegationQuotaPeriodStart     DateTime?                  @map("delegation_quota_period_start")
  // ── Loop closure ──
  followUpRequired               Boolean                    @default(false) @map("follow_up_required")
  followUpNotes                  String?                    @map("follow_up_notes") @db.Text
  completedAt                    DateTime?                  @map("completed_at")
  reputationApplied              Boolean                    @default(false) @map("reputation_applied")
  createdAt                      DateTime                   @default(now()) @map("created_at")
  updatedAt                      DateTime                   @updatedAt @map("updated_at")

  attachments AffiliateTaskAttachment[]
  reviews     AffiliateTaskReview[]
  events      AffiliateTaskEvent[]
  settlement  AffiliateTaskSettlement?

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([category])
  @@index([taskDefinitionId])
  @@index([sourceAssignmentId])
  @@index([prerequisiteTaskId])
  @@index([paymentStatus])
  @@index([affiliateTaskId])
  @@index([createdAt])
  @@map("affiliate_tasks")
}

model AffiliateTaskAttachment {
  id           String        @id @default(cuid())
  taskId       String        @map("task_id")
  task         AffiliateTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url          String        @map("url") @db.Text
  fileName     String?       @map("file_name")
  mimeType     String?       @map("mime_type")
  kind         String        @default("OTHER") @map("kind") // IMAGE | DOCUMENT | OTHER
  uploadedById String?       @map("uploaded_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([taskId])
  @@map("affiliate_task_attachments")
}

model AffiliateTaskReview {
  id             String                  @id @default(cuid())
  taskId         String                  @map("task_id")
  task           AffiliateTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  round          Int                     @default(1) @map("round")
  decision       AffiliateReviewDecision @map("decision")
  notes          String?                 @map("notes") @db.Text
  reviewerId     String?                 @map("reviewer_id")
  reviewer       User?                   @relation("AffiliateTaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  // ADMIN | ACCOUNT_MANAGER | BUSINESS — which stage of the review produced it.
  stage          String                  @default("ADMIN") @map("stage")
  reviewedAt     DateTime                @default(now()) @map("reviewed_at")
  acknowledgedAt DateTime?               @map("acknowledged_at")
  createdAt      DateTime                @default(now()) @map("created_at")

  @@index([taskId])
  @@map("affiliate_task_reviews")
}

// Append-only reputation ledger. Current score is stored denormalised on the
// affiliate profile and recomputed transactionally whenever an event lands.
model AffiliateReputationEvent {
  id              String   @id @default(cuid())
  affiliateUserId String   @map("affiliate_user_id")
  affiliate       User     @relation(fields: [affiliateUserId], references: [id], onDelete: Cascade)
  delta           Int      @map("delta")
  reason          String   @map("reason")
  sourceType      String   @map("source_type") // TASK_COMPLETED | TASK_FAILED | RATING | REPORT
  sourceId        String?  @map("source_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([affiliateUserId, createdAt])
  @@map("affiliate_reputation_events")
}

model AffiliateRating {
  id              String                @id @default(cuid())
  businessId      String                @map("business_id")
  business        BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  affiliateUserId String                @map("affiliate_user_id")
  affiliate       User                  @relation("AffiliateRatingTarget", fields: [affiliateUserId], references: [id], onDelete: Cascade)
  rating          Int                   @map("rating") // 1..5
  comment         String?               @map("comment") @db.Text
  status          AffiliateRatingStatus @default(APPROVED) @map("status")
  createdByUserId String                @map("created_by_user_id")
  createdBy       User                  @relation("AffiliateRatingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  reviewedBy      String?               @map("reviewed_by")
  reviewedAt      DateTime?             @map("reviewed_at")
  createdAt       DateTime              @default(now()) @map("created_at")

  @@unique([businessId, affiliateUserId])
  @@index([affiliateUserId])
  @@map("affiliate_ratings")
}

model AffiliateReport {
  id                String                @id @default(cuid())
  businessId        String                @map("business_id")
  business          BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  affiliateUserId   String                @map("affiliate_user_id")
  affiliate         User                  @relation("AffiliateReportTarget", fields: [affiliateUserId], references: [id], onDelete: Cascade)
  reason            String                @map("reason")
  description       String                @map("description") @db.Text
  status            AffiliateReportStatus @default(PENDING) @map("status")
  adminNotes        String?               @map("admin_notes") @db.Text
  reviewedBy        String?               @map("reviewed_by")
  reviewer          User?                 @relation("AffiliateReportReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?             @map("reviewed_at")
  reputationApplied Boolean               @default(false) @map("reputation_applied")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([affiliateUserId])
  @@index([status])
  @@map("affiliate_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Business acquisition & attribution (247GBS Affiliates)
//
// A business can have three independent relationships with the affiliate
// network at the same time: who introduced it (acquisition), who manages the
// relationship (account manager), and who performs specialist work (tasks).
// These models keep the acquisition trail separate from management and work.
// ─────────────────────────────────────────────────────────────────────────────

enum AffiliateBusinessAcquisitionStatus {
  PROSPECT
  INVITED
  REGISTERED
  ONBOARDING_COMPLETED
  VERIFIED
  REJECTED
  CANCELLED
}

enum BusinessRelationshipType {
  ACQUISITION
  ONBOARDING_ASSISTANCE
  ACCOUNT_MANAGEMENT
  CONSULTANT_ASSIGNMENT
  TASK_ASSIGNMENT
  ATTRIBUTION_CHANGE
}

/// A tracked invitation created by an affiliate for a specific business
/// prospect. The token is the only thing the business needs to register and
/// still be permanently attributed to the affiliate who introduced them.
model AffiliateBusinessInvitation {
  id                 String                            @id @default(uuid())
  token              String                            @unique
  affiliateUserId    String?                           @map("affiliate_user_id")
  affiliateExternalId String?                          @map("affiliate_external_id")
  affiliateName      String                            @map("affiliate_name")
  affiliateEmail     String                            @map("affiliate_email")
  affiliateRole      String                            @map("affiliate_role")
  prospectExternalId String?                           @map("prospect_external_id")
  businessName       String                            @map("business_name")
  contactName        String?                           @map("contact_name")
  businessPhone      String?                           @map("business_phone")
  businessEmail      String?                           @map("business_email")
  postcode           String?
  address            String?
  category           String?
  notes              String?                           @db.Text
  status             AffiliateBusinessAcquisitionStatus @default(INVITED)
  businessId         String?                           @map("business_id")
  business           BusinessProfile?                   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  registeredUserId   String?                           @map("registered_user_id")
  registeredAt       DateTime?                         @map("registered_at")
  onboardingCompletedAt DateTime?                      @map("onboarding_completed_at")
  verifiedAt         DateTime?                         @map("verified_at")
  verifiedByUserId   String?                           @map("verified_by_user_id")
  cancelledAt        DateTime?                         @map("cancelled_at")
  metadata           Json?
  createdAt          DateTime                          @default(now()) @map("created_at")
  updatedAt          DateTime                          @updatedAt @map("updated_at")

  @@index([affiliateUserId])
  @@index([affiliateExternalId])
  @@index([prospectExternalId])
  @@index([status])
  @@index([businessId])
  @@map("affiliate_business_invitations")
}

/// A post-registration claim by an affiliate who helped a business register
/// without using the tracked invitation (e.g. in person). Claims require
/// verification before they can change the permanent acquisition record.
model AffiliateBusinessClaim {
  id                  String   @id @default(uuid())
  businessId          String?  @map("business_id")
  businessEmail       String?  @map("business_email")
  businessName        String?  @map("business_name")
  affiliateUserId     String?  @map("affiliate_user_id")
  affiliateExternalId String?  @map("affiliate_external_id")
  affiliateName       String   @map("affiliate_name")
  affiliateEmail      String   @map("affiliate_email")
  affiliateRole       String   @map("affiliate_role")
  prospectExternalId  String?  @map("prospect_external_id")
  evidence            String?  @db.Text
  status              String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedByUserId    String?  @map("reviewed_by_user_id")
  reviewedAt          DateTime? @map("reviewed_at")
  reviewNotes         String?  @map("review_notes") @db.Text
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([businessId])
  @@index([affiliateUserId])
  @@index([affiliateExternalId])
  @@map("affiliate_business_claims")
}

/// Append-only relationship trail. Changing an account manager or a task
/// assignee never overwrites history — it closes the previous record and
/// opens a new one.
model BusinessRelationshipHistory {
  id                  String                   @id @default(uuid())
  businessId          String                   @map("business_id")
  business            BusinessProfile          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  relationshipType    BusinessRelationshipType @map("relationship_type")
  affiliateUserId     String?                  @map("affiliate_user_id")
  affiliateExternalId String?                  @map("affiliate_external_id")
  actorUserId         String?                  @map("actor_user_id")
  previousValue       String?                  @map("previous_value")
  newValue            String?                  @map("new_value")
  metadata            Json?
  startedAt           DateTime                 @default(now()) @map("started_at")
  endedAt             DateTime?                @map("ended_at")
  createdAt           DateTime                 @default(now()) @map("created_at")

  @@index([businessId, relationshipType])
  @@index([affiliateUserId])
  @@index([affiliateExternalId])
  @@map("business_relationship_history")
}
