datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUSINESS
  CUSTOMER
  ADMIN
  AGENT
  CONSULTANT
  ACCOUNT_MANAGER
  PARTNER
}

enum MembershipLevel {
  Bronze
  Silver
  Gold
  Platinum
}

enum MembershipTier {
  Free
  Normal
  Pro
  ProPlus @map("Pro+")
}

enum MembershipStatus {
  active
  inactive
  trial
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  password                String
  role                    Role                      @default(BUSINESS)
  firstName               String?
  lastName                String?
  jobTitle                String?                   @default("Managing Director")
  twoFactorEnabled        Boolean                   @default(false)
  emailNotifications      Boolean                   @default(true)
  smsNotifications        Boolean                   @default(false)
  registrationSource      String?                   @default("direct")
  adminRole               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?                 @map("deleted_at")
  // Phase 3: session version — bumped on password reset / role change / ban-deactivate.
  // Outstanding access tokens carry `tv` and are rejected when it mismatches.
  tokenVersion            Int                       @default(0) @map("token_version")
  referralCode            String?                   @unique @map("referral_code")
  referredById            String?                   @map("referred_by_id")
  referredBy              User?                     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               User[]                    @relation("Referrals")
  businessProfile         BusinessProfile?
  customerProfile         CustomerProfile?
  agentProfile            AgentProfile?
  consultantProfile       ConsultantProfile?
  accountManagerProfile   AccountManagerProfile?
  ssoSessions             SsoSession[]
  refreshSessions         RefreshSession[]
  resetCodes              PasswordResetCode[]
  wallet                  Wallet?
  walletTopUps            WalletTopUpRequest[]
  taskAssignments         UserTaskAssignment[]
  conversationsCreated    Conversation[]            @relation("ConversationCreator")
  conversationMemberships ConversationParticipant[]
  sentMessages            Message[]                 @relation("MessageSender")
  messageReadReceipts     MessageReadReceipt[]
  pushSubscriptions       PushSubscription[]
  notificationPreference  NotificationPreference?
  messageRequestsSent     ChatMessageRequest[]      @relation("MessageRequestsSent")
  messageRequestsReceived ChatMessageRequest[]      @relation("MessageRequestsReceived")
  blocksSent              ChatBlock[]               @relation("UserBlocksSent")
  blocksReceived          ChatBlock[]               @relation("UserBlocksReceived")

  @@index([deletedAt])
  @@index([role])
  @@index([referredById])
}

model BusinessProfile {
  id                     String               @id @default(uuid())
  userId                 String               @unique
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName           String
  businessType           String
  country                String
  phone                  String
  email                  String
  isOnGoogle             Boolean              @default(false)
  googlePlaceId          String?
  address                String?
  postcode               String?
  industry               String?
  category               String?
  subCategory            String?
  description            String?
  website                String?
  logoUrl                String?
  openingHours           String?
  socialMedia            String?
  membershipLevel        MembershipLevel      @default(Bronze)
  membershipTier         MembershipTier       @default(Normal)
  membershipStatus       MembershipStatus     @default(active)
  membershipPlanName     String?              @map("membership_plan_name")
  membershipExpiresAt    DateTime?            @map("membership_expires_at")
  hasPaidVerificationFee Boolean              @default(false) @map("has_paid_verification_fee")
  verificationFeePaidAt  DateTime?            @map("verification_fee_paid_at")
  trialAccessDays        Int                  @default(14) @map("trial_access_days")
  trialAccessExpiresAt   DateTime?            @map("trial_access_expires_at")
  apiKey                 String?              @unique
  localMallName          String?
  localMallId            String?
  proximityTier          String?              @default("national") // high_street, national
  packages               PlatformPackage[]
  transactions           BillingTransaction[]
  notifications          Notification[]
  supportTickets         SupportTicket[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?            @map("deleted_at")

  @@index([deletedAt])
  @@index([membershipExpiresAt])
  @@index([localMallId])
  @@index([membershipStatus])
}

model Notification {
  id         String           @id @default(uuid())
  businessId String?
  business   BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Phase 4: user-scoped delivery. Plain (non-FK) string on purpose — deleting
  // a user must not cascade-delete their notification history (audit trail).
  userId     String?          @map("user_id")
  type       String // membership, package, update, payment, announcement
  title      String
  message    String
  read       Boolean          @default(false)
  data       Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId])
  @@index([businessId, read, createdAt])
}

model PlatformPackage {
  id                     String          @id @default(uuid())
  businessId             String
  business               BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform               String // MCOM Mall, MCOM Rewards, MCOM Spin, GBS Audit, GBS Expo
  packageName            String // Starter, Standard, Enterprise, or plan name from external service
  status                 String          @default("active") // active, inactive, expired
  limits                 Json? // JSON holding keys like rewardsLimit, campaignsLimit, etc.
  externalPlanId         String? // Plan ID from external service (Mall/Rewards)
  planName               String? // Display name from external plan
  planType               String? // STANDARD, TRIAL, SEASONAL
  expiresAt              DateTime? // When the subscription expires (null = no expiry)
  provider               String? // 'stripe' or 'paypal'
  providerSubscriptionId String? // Stripe subscription ID or PayPal subscription ID
  amount                 Float? // Amount paid
  currency               String          @default("GBP")
  billingCycle           String? // monthly, quarterly, annual
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([businessId, platform])
  @@index([externalPlanId])
  @@index([expiresAt])
}

model BillingTransaction {
  id                String          @id @default(uuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount            Float
  description       String
  status            String          @default("paid") // paid, pending, failed, refunded
  platformPackageId String? // Link to platform package purchased
  provider          String? // 'stripe' or 'paypal'
  providerPaymentId String?         @unique // Stripe payment intent ID or PayPal order ID (idempotency key)
  createdAt         DateTime        @default(now())

  @@index([platformPackageId])
  @@index([businessId, status])
  @@index([createdAt])
  @@index([businessId, status, createdAt])
}

// Phase 2 (G1): PayPal capture outbox. When the upstream capture succeeds but
// the local activation write fails, the activation intent is parked here and
// retried by cron — money is never silently dropped.
model PaymentOutbox {
  id                String   @id @default(uuid())
  provider          String   @default("paypal")
  providerPaymentId String   @unique
  kind              String // 'membership' | 'platform'
  businessId        String
  payload           Json // level/tier/billing or platform/externalPlanId/billingCycle + expected amount
  status            String   @default("PENDING") // PENDING | DONE | FAILED
  attempts          Int      @default(0)
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
  @@map("payment_outbox")
}

// ─── MCOM PAY — GENERIC APP PAYMENTS LEDGER ─────────────────────────────────
// Any Console-registered app (SsoClient) can charge its customers for anything
// it sells, and MCOM processes the payment (Stripe / PayPal / MCOM wallet).
// Amounts are stored in MINOR units (pence) as BigInt — never floats — so money
// is exact. AppCharge is the header row (attribution + gross/fee/net); the
// double-entry rows live in AppPaymentLedgerEntry (append-only).

enum AppChargeMethod {
  stripe
  paypal
  wallet
}

enum AppChargeStatus {
  pending
  paid
  failed
  refunded
  cancelled
}

enum LedgerDirection {
  debit
  credit
}

enum LedgerAccount {
  gateway_clearing
  wallet_clearing
  app_payable
  mcom_revenue
  refund
}

model AppCharge {
  id                 String          @id @default(cuid())
  appClientId        String          @map("app_client_id") // SsoClient.clientId (natural key)
  amountMinor        BigInt          @map("amount_minor") // gross charge, pence
  currency           String          @default("GBP")
  feeMinor           BigInt          @default(0) @map("fee_minor")
  netMinor           BigInt          @map("net_minor") // amountMinor - feeMinor (owed to app)
  method             AppChargeMethod @map("method")
  status             AppChargeStatus @default(pending)
  reference          String? // app's order/invoice id
  description        String?
  mcomUserId         String?         @map("mcom_user_id") // payer's MCOM identity
  externalCustomerId String?         @map("external_customer_id") // app's own customer id
  provider           String? // stripe | paypal (card methods only)
  providerRef        String?         @unique @map("provider_ref") // PaymentIntent/order id
  walletDebitAmount  Decimal?        @map("wallet_debit_amount") @db.Decimal(18, 4) // MCOM credits debited (wallet method)
  idempotencyKey     String          @unique @map("idempotency_key")
  metadata           Json?
  failureReason      String?         @map("failure_reason")
  paidAt             DateTime?       @map("paid_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  ledgerEntries AppPaymentLedgerEntry[]

  @@index([appClientId, createdAt(sort: Desc)])
  @@index([status])
  @@index([mcomUserId])
  @@index([reference])
  @@map("app_charges")
}

model AppPaymentLedgerEntry {
  id             String          @id @default(cuid())
  chargeId       String          @map("charge_id")
  charge         AppCharge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  appClientId    String          @map("app_client_id")
  account        LedgerAccount   @map("account")
  direction      LedgerDirection @map("direction")
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @default("GBP")
  mcomUserId     String?         @map("mcom_user_id")
  provider       String?
  providerRef    String?         @map("provider_ref")
  reference      String?
  metadata       Json?
  idempotencyKey String          @unique @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([chargeId])
  @@index([appClientId, createdAt(sort: Desc)])
  @@index([account])
  @@map("app_payment_ledger_entries")
}

model SsoClient {
  id           String        @id @default(cuid())
  clientId     String        @unique @map("client_id")
  clientSecret String        @map("client_secret")
  name         String
  redirectUris String[]      @map("redirect_uris")
  scopes       String[]
  logoUrl      String?       @map("logo_url")
  apiKey       String?       @unique @map("api_key")
  isActive     Boolean       @default(true) @map("is_active")
  authCodes    SsoAuthCode[]
  ssoSessions  SsoSession[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // ── MCOM CONSOLE FIELDS (additive — safe migration) ─────────────────────
  description      String?   @map("description")
  appUrl           String?   @map("app_url")
  billingApiUrl    String?   @map("billing_api_url")
  hmacSecret       String?   @map("hmac_secret")
  webhookSecret    String?   @map("webhook_secret")
  webhookUrl       String?   @map("webhook_url")
  platformSlug     String?   @unique @map("platform_slug")
  corsOrigins      String[]  @default([]) @map("cors_origins")
  isSystemApp      Boolean   @default(false) @map("is_system_app")
  metadata         Json?     @map("metadata")
  lastWebhookAt    DateTime? @map("last_webhook_at")
  webhookFailCount Int       @default(0) @map("webhook_fail_count")

  // ── MCOM PAY fee config (per-app override; falls back to ProgrammeSetting) ─
  feePercent    Decimal? @map("fee_percent") @db.Decimal(5, 4)
  feeFixedMinor BigInt?  @map("fee_fixed_minor")

  // ── Ecosystem service-to-service identity (M2M, additive) ────────────────
  // Enables a registered app's backend to call another registered app's
  // backend directly (peer-to-peer). MCOM is only the credential issuer and
  // registry; requests never transit MCOM.
  serviceEnabled   Boolean  @default(true) @map("service_enabled")
  serviceBaseUrl   String?  @map("service_base_url")
  serviceScopes    String[] @default([]) @map("service_scopes")
  allowedAudiences String[] @default([]) @map("allowed_audiences")
  allowedCallers   String[] @default([]) @map("allowed_callers")

  @@index([clientId])
  @@index([apiKey])
  @@index([platformSlug])
  @@index([isActive])
  @@map("sso_clients")
}

// Audit trail for issued ecosystem service tokens (control-plane traceability).
// FK-free by design: tokens outlive/relate to clients by natural key and must
// survive client deletion. Append-only.
model ServiceTokenAudit {
  id        String   @id @default(cuid())
  jti       String   @unique @map("jti")
  tokenType String   @map("token_type") // "service" | "delegated"
  clientId  String   @map("client_id")  // caller app (sub for service, act.sub for delegated)
  subject   String?  @map("subject")    // end-user id for delegated tokens
  audience  String?  @map("audience")
  scopes    String[] @default([])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([createdAt])
  @@map("service_token_audit")
}

model AppWebhookLog {
  id           String    @id @default(cuid())
  // Phase 5: intentionally FK-free. Append-only delivery log keyed by the
  // client's natural key (SsoClient.clientId string, not its cuid id) —
  // logs must survive client deletion, and a restrictive FK would block it.
  clientId     String    @map("client_id")
  event        String    @map("event")
  payload      Json      @map("payload")
  statusCode   Int?      @map("status_code")
  responseBody String?   @map("response_body")
  deliveredAt  DateTime? @map("delivered_at")
  failed       Boolean   @default(false) @map("failed")
  jobId        String?   @map("job_id")
  retryCount   Int       @default(0) @map("retry_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([clientId])
  @@index([createdAt])
  @@index([clientId, createdAt])
  @@index([jobId])
  @@map("app_webhook_logs")
}

model ConsoleAuditLog {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  clientId  String   @map("client_id")
  action    String   @map("action")
  changes   Json?    @map("changes")
  ip        String?  @map("ip")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([adminId])
  @@index([createdAt])
  @@map("console_audit_logs")
}

model SsoAuthCode {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String    @map("user_id")
  clientId    String    @map("client_id")
  client      SsoClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri String    @map("redirect_uri")
  scopes      String[]
  expiresAt   DateTime  @map("expires_at")
  used        Boolean   @default(false) @map("used")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([code])
  @@index([userId])
  @@map("sso_auth_codes")
}

model SsoSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String    @map("client_id")
  client       SsoClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accessToken  String    @unique @map("access_token")
  refreshToken String    @unique @map("refresh_token")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([clientId])
  @@index([accessToken])
  @@index([refreshToken])
  @@map("sso_sessions")
}

// Phase 3: regular-auth refresh sessions. Refresh tokens are stored as SHA-256
// hashes (never plaintext) and rotated on every use. A presented token that
// matches a replaced (rotated) session is treated as reuse/theft and revokes
// all sessions for the user.
model RefreshSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti          String    @unique @map("jti")
  hashedToken  String    @unique @map("hashed_token")
  // Access token this session was issued alongside. On logout the session is
  // revoked and JwtStrategy rejects the matching access `jti` until it expires.
  accessJti    String?   @map("access_jti")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ip           String?   @map("ip")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([accessJti])
  @@map("refresh_sessions")
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String?  @map("email")
  purpose   String   @default("PASSWORD_RESET") @map("purpose") // OTP | PASSWORD_RESET
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  used      Boolean  @default(false) @map("used")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([code])
  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@map("password_reset_codes")
}

// ─── ADMIN DASHBOARD PROFILE TABLES ──────────────────────────────────────────

model CustomerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?   @map("phone")
  loyaltyPoints    Int       @default(0) @map("loyalty_points")
  platformUsage    String[]  @map("platform_usage")
  membershipStatus String    @default("None") @map("membership_status")
  status           String    @default("Active") @map("status")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("customer_profiles")
}

model AgentProfile {
  id          String    @id @default(cuid())
  userId      String    @unique @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?   @map("phone")
  permissions String[]  @map("permissions")
  status      String    @default("Active") @map("status")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("agent_profiles")
}

model ConsultantProfile {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?   @map("phone")
  specialisation String    @map("specialisation")
  status         String    @default("Active") @map("status")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("consultant_profiles")
}

model AccountManagerProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String?   @map("phone")
  assignedBusinesses Int       @default(0) @map("assigned_businesses")
  status             String    @default("Active") @map("status")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("account_manager_profiles")
}

// ─── ADMIN DASHBOARD CONFIG & ENTITY TABLES ──────────────────────────────────

model MembershipPlan {
  id             String    @id @default(cuid())
  name           String    @map("name")
  description    String    @map("description")
  price          Float     @map("price")
  billingCycle   String    @map("billing_cycle")
  monthlyPrice   Float?    @map("monthly_price")
  quarterlyPrice Float?    @map("quarterly_price")
  annualPrice    Float?    @map("annual_price")
  platformAccess String[]  @map("platform_access")
  usageLimits    Json      @map("usage_limits")
  permissions    String[]  @map("permissions")
  archived       Boolean   @default(false) @map("archived")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Multi-App Bundle & Dynamic Presentation Extensions
  // NOTE: tier_* / includedApps JSON columns are legacy mirrors (kept for
  // backwards compatibility). The relational tables below
  // (MembershipPlanTier + children) are the source of truth for pricing,
  // durations, features, entitlements and bundles.
  includedApps     Json?    @map("included_apps")
  tierPrices       Json?    @map("tier_prices")
  tierFeatures     Json?    @map("tier_features")
  tierEntitlements Json?    @map("tier_entitlements")
  tierDurations    Json?    @map("tier_durations")
  whoItIsFor       String?  @map("who_it_is_for")
  badge            String?  @map("badge")
  color            String?  @map("color")
  features         String[] @default([]) @map("features")

  tiers      MembershipPlanTier[]
  appBundles MembershipPlanAppBundle[]

  @@index([archived])
  @@index([deletedAt])
  @@map("membership_plans")
}

// ─── MEMBERSHIP TIERS & FLEXIBLE PAYMENT OPTIONS (relational) ────────────────
// Replaces the tier_* JSON blobs on MembershipPlan with queryable rows.
// One row per (plan, tier); payment splits are rows on
// MembershipPaymentOption. Backfilled from JSON by migration
// 20261008000000_membership_tier_payment_options (idempotent, ON CONFLICT
// DO NOTHING) — the JSON columns are left untouched.

enum PlanTier {
  Standard
  Pro
  ProPlus  @map("Pro+")
}

enum MembershipPaymentPlan {
  full
  monthly
  quarterly
  halfYearly @map("half_yearly")
}

enum PaymentPriceMode {
  manual
  auto
}

model MembershipPlanTier {
  id           String         @id @default(cuid())
  planId       String         @map("plan_id")
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tier         PlanTier       @map("tier")
  durationDays Int            @map("duration_days")
  fullPrice    Float          @map("full_price")
  sortOrder    Int            @default(0) @map("sort_order")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  features       MembershipTierFeature[]
  entitlements   MembershipTierEntitlement[]
  paymentOptions MembershipPaymentOption[]

  @@unique([planId, tier])
  @@index([planId])
  @@map("membership_plan_tiers")
}

model MembershipPaymentOption {
  id                                 String                              @id @default(cuid())
  tierId                             String                              @map("tier_id")
  tier                               MembershipPlanTier                  @relation(fields: [tierId], references: [id], onDelete: Cascade)
  paymentPlan                        MembershipPaymentPlan               @map("payment_plan")
  installments                       Int                                 @map("installments")
  mode                               PaymentPriceMode                    @map("mode")
  manualPrice                        Float?                              @map("manual_price")
  surchargePct                       Float?                              @map("surcharge_pct")
  perChargePrice                     Float                               @map("per_charge_price")
  totalPrice                         Float                               @map("total_price")
  sliceDays                          Int                                 @map("slice_days")
  isActive                           Boolean                             @default(true) @map("is_active")
  stripePriceId                      String?                             @map("stripe_price_id")
  paypalPlanId                       String?                             @map("paypal_plan_id")
  sortOrder                          Int                                 @default(0) @map("sort_order")
