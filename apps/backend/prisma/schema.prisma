datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUSINESS
  CUSTOMER
  ADMIN
  AGENT
  CONSULTANT
  ACCOUNT_MANAGER
  PARTNER
}

enum MembershipLevel {
  Bronze
  Silver
  Gold
  Platinum
}

enum MembershipTier {
  Free
  Normal
  Pro
  ProPlus @map("Pro+")
}

enum MembershipStatus {
  active
  inactive
  trial
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  role               Role                @default(BUSINESS)
  firstName          String?
  lastName           String?
  jobTitle           String?             @default("Managing Director")
  twoFactorEnabled   Boolean             @default(false)
  emailNotifications Boolean             @default(true)
  smsNotifications   Boolean             @default(false)
  registrationSource String?             @default("direct")
  adminRole          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  businessProfile    BusinessProfile?
  customerProfile    CustomerProfile?
  agentProfile       AgentProfile?
  consultantProfile  ConsultantProfile?
  accountManagerProfile AccountManagerProfile?
  ssoSessions        SsoSession[]
  resetCodes         PasswordResetCode[]
  wallet             Wallet?
  walletTopUps       WalletTopUpRequest[]
}

model BusinessProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  businessType     String
  country          String
  phone            String
  email            String
  isOnGoogle       Boolean           @default(false)
  googlePlaceId    String?
  address          String?
  postcode         String?
  industry         String?
  category         String?
  subCategory      String?
  description      String?
  website          String?
  logoUrl          String?
  openingHours     String?
  socialMedia      String?
  membershipLevel  MembershipLevel   @default(Bronze)
  membershipTier   MembershipTier    @default(Normal)
  membershipStatus MembershipStatus  @default(active)
  apiKey           String?           @unique
  localMallName    String?
  localMallId      String?
  proximityTier    String?           @default("national") // high_street, national
  packages         PlatformPackage[]
  transactions     BillingTransaction[]
  notifications    Notification[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Notification {
  id          String          @id @default(uuid())
  businessId  String?
  business    BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        String          // membership, package, update, payment, announcement
  title       String
  message     String
  read        Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PlatformPackage {
  id                      String          @id @default(uuid())
  businessId              String
  business                BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform                String          // MCOM Mall, MCOM Rewards, MCOM Spin, GBS Audit, GBS Expo
  packageName             String          // Starter, Standard, Enterprise, or plan name from external service
  status                  String          @default("active") // active, inactive, expired
  limits                  Json?           // JSON holding keys like rewardsLimit, campaignsLimit, etc.
  externalPlanId          String?         // Plan ID from external service (Mall/Rewards)
  planName                String?         // Display name from external plan
  planType                String?         // STANDARD, TRIAL, SEASONAL
  expiresAt               DateTime?       // When the subscription expires (null = no expiry)
  provider                String?         // 'stripe' or 'paypal'
  providerSubscriptionId  String?         // Stripe subscription ID or PayPal subscription ID
  amount                  Float?          // Amount paid
  currency                String          @default("GBP")
  billingCycle            String?         // monthly, quarterly, annual
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@unique([businessId, platform])
  @@index([externalPlanId])
  @@index([expiresAt])
}

model BillingTransaction {
  id                  String          @id @default(uuid())
  businessId          String
  business            BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount              Float
  description         String
  status              String          @default("paid") // paid, pending, failed, refunded
  platformPackageId   String?         // Link to platform package purchased
  provider            String?         // 'stripe' or 'paypal'
  providerPaymentId   String?         // Stripe payment intent ID or PayPal order ID
  createdAt           DateTime        @default(now())

  @@index([platformPackageId])
}

model SsoClient {
  id           String        @id @default(cuid())
  clientId     String        @unique @map("client_id")
  clientSecret String        @map("client_secret")
  name         String
  redirectUris String[]      @map("redirect_uris")
  scopes       String[]
  logoUrl      String?       @map("logo_url")
  apiKey       String?       @unique @map("api_key")
  isActive     Boolean       @default(true) @map("is_active")
  authCodes    SsoAuthCode[]
  ssoSessions  SsoSession[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // ── MCOM CONSOLE FIELDS (additive — safe migration) ─────────────────────
  description     String?   @map("description")
  appUrl          String?   @map("app_url")
  billingApiUrl   String?   @map("billing_api_url")
  hmacSecret      String?   @map("hmac_secret")
  webhookSecret   String?   @map("webhook_secret")
  webhookUrl      String?   @map("webhook_url")
  platformSlug    String?   @unique @map("platform_slug")
  corsOrigins     String[]  @default([]) @map("cors_origins")
  isSystemApp     Boolean   @default(false) @map("is_system_app")
  metadata        Json?     @map("metadata")
  lastWebhookAt   DateTime? @map("last_webhook_at")
  webhookFailCount Int      @default(0) @map("webhook_fail_count")

  @@index([clientId])
  @@index([apiKey])
  @@index([platformSlug])
  @@index([isActive])
  @@map("sso_clients")
}

model AppWebhookLog {
  id           String    @id @default(cuid())
  clientId     String    @map("client_id")
  event        String    @map("event")
  payload      Json      @map("payload")
  statusCode   Int?      @map("status_code")
  responseBody String?   @map("response_body")
  deliveredAt  DateTime? @map("delivered_at")
  failed       Boolean   @default(false) @map("failed")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([clientId])
  @@index([createdAt])
  @@index([clientId, createdAt])
  @@map("app_webhook_logs")
}

model ConsoleAuditLog {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  clientId  String   @map("client_id")
  action    String   @map("action")
  changes   Json?    @map("changes")
  ip        String?  @map("ip")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([adminId])
  @@index([createdAt])
  @@map("console_audit_logs")
}

model SsoAuthCode {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String    @map("user_id")
  clientId    String    @map("client_id")
  client      SsoClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri String    @map("redirect_uri")
  scopes      String[]
  expiresAt   DateTime  @map("expires_at")
  used        Boolean   @default(false) @map("used")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([code])
  @@index([userId])
  @@map("sso_auth_codes")
}

model SsoSession {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String   @map("client_id")
  client       SsoClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accessToken  String   @unique @map("access_token")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([clientId])
  @@index([accessToken])
  @@index([refreshToken])
  @@map("sso_sessions")
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String?  @map("email")
  purpose   String   @default("PASSWORD_RESET") @map("purpose") // OTP | PASSWORD_RESET
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  used      Boolean  @default(false) @map("used")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([code])
  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@map("password_reset_codes")
}

// ─── ADMIN DASHBOARD PROFILE TABLES ──────────────────────────────────────────

model CustomerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?  @map("phone")
  loyaltyPoints    Int      @default(0) @map("loyalty_points")
  platformUsage    String[] @map("platform_usage")
  membershipStatus String   @default("None") @map("membership_status")
  status           String   @default("Active") @map("status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("customer_profiles")
}

model AgentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?  @map("phone")
  permissions String[] @map("permissions")
  status      String   @default("Active") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("agent_profiles")
}

model ConsultantProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?  @map("phone")
  specialisation String   @map("specialisation")
  status         String   @default("Active") @map("status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("consultant_profiles")
}

model AccountManagerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String?  @map("phone")
  assignedBusinesses Int      @default(0) @map("assigned_businesses")
  status             String   @default("Active") @map("status")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account_manager_profiles")
}

// ─── ADMIN DASHBOARD CONFIG & ENTITY TABLES ──────────────────────────────────

model MembershipPlan {
  id             String   @id @default(cuid())
  name           String   @map("name")
  description    String   @map("description")
  price          Float    @map("price")
  billingCycle   String   @map("billing_cycle")
  platformAccess String[] @map("platform_access")
  usageLimits    Json     @map("usage_limits")
  permissions    String[] @map("permissions")
  archived       Boolean  @default(false) @map("archived")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("membership_plans")
}

model PackageTemplate {
  id           String   @id @default(cuid())
  name         String   @map("name")
  platform     String   @map("platform")
  description  String   @map("description")
  price        Float    @map("price")
  billingCycle String   @map("billing_cycle")
  features     String[] @map("features")
  usageLimits  Json     @map("usage_limits")
  accessRights String[] @map("access_rights")
  archived     Boolean  @default(false) @map("archived")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("package_templates")
}

model ExternalPlan {
  id                     String   @id @default(cuid())
  name                   String   @map("name")
  platform               String   @map("platform") // MCOM Mall, MCOM Rewards, MCOM Spin, GBS Audit, GBS Expo
  description            String?  @map("description")
  monthlyPrice           Decimal? @map("monthly_price")
  quarterlyPrice         Decimal? @map("quarterly_price")
  annualPrice            Decimal? @map("annual_price")
  features               String[] @map("features")
  configuration          Json?    @map("configuration")
  isActive               Boolean  @default(true) @map("is_active")
  isDefault              Boolean  @default(false) @map("is_default")
  type                   String?  @map("type")
  trialDuration          Int?     @map("trial_duration")
  seasonId               String?  @map("season_id")
  stripeMonthlyPriceId   String?  @map("stripe_monthly_price_id")
  stripeQuarterlyPriceId String?  @map("stripe_quarterly_price_id")
  stripeAnnualPriceId    String?  @map("stripe_annual_price_id")
  paypalMonthlyPlanId    String?  @map("paypal_monthly_plan_id")
  paypalQuarterlyPlanId  String?  @map("paypal_quarterly_plan_id")
  paypalAnnualPlanId     String?  @map("paypal_annual_plan_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([platform])
  @@index([platform, isActive])
  @@map("external_plans")
}

// ─── SECTOR / CATEGORY / SUBCATEGORY CATALOG ────────────────────────────────
// Drives the onboarding category picker (GET /sectors, /categories, /subcategories)
// and the Google type → sector mapping (BusinessService.mapGoogleCategory).

model Sector {
  id         String     @id @default(cuid())
  name       String     @map("name")
  slug       String     @unique @map("slug")
  sortOrder  Int        @default(0) @map("sort_order")
  categories Category[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("sectors")
}

model Category {
  id            String                @id @default(cuid())
  sectorId      String                @map("sector_id")
  sector        Sector                @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  name          String                @map("name")
  slug          String                @unique @map("slug")
  sortOrder     Int                   @default(0) @map("sort_order")
  subCategories SubCategory[]
  googleMappings GoogleCategoryMapping[]
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([sectorId])
  @@index([sortOrder])
  @@map("categories")
}

model GoogleCategoryMapping {
  id         String   @id @default(cuid())
  googleType String   @unique @map("google_type") // e.g. 'coffee_shop'
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([categoryId])
  @@map("google_category_mappings")
}

model SubCategory {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String   @map("name")
  slug       String   @unique @map("slug")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([sortOrder])
  @@map("sub_categories")
}

model EcosystemSubscription {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  businessName String   @map("business_name")
  type         String   @map("type") // 'Membership' | 'Package'
  itemName     String   @map("item_name")
  status       String   @default("Active") @map("status")
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  amount       Float    @map("amount")
  billingCycle String   @map("billing_cycle")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("ecosystem_subscriptions")
}

model EcosystemPlatform {
  id          String   @id @default(cuid())
  name        String   @map("name")
  description String   @map("description")
  status      String   @default("Enabled") @map("status") // Enabled, Disabled, Maintenance, Restricted
  icon        String   @map("icon")
  launchDate  DateTime @map("launch_date")
  totalUsers  Int      @default(0) @map("total_users")
  visible     Boolean  @default(true) @map("visible")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ecosystem_platforms")
}

model PermissionRole {
  role        String   @id @map("role")
  permissions Json     @map("permissions")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("permission_roles")
}

model AdminPayment {
  id           String   @id @default(cuid())
  businessId   String?  @map("business_id")
  businessName String   @map("business_name")
  amount       Float    @map("amount")
  currency     String   @default("GBP") @map("currency")
  method       String   @map("method")
  status       String   @map("status") // Completed, Pending, Failed, Refunded
  date         DateTime @default(now()) @map("date")
  invoice      String   @map("invoice")
  type         String   @map("type") // Membership, Package, One-time
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("admin_payments")
}

model BroadcastNotification {
  id            String    @id @default(cuid())
  title         String    @map("title")
  message       String    @map("message")
  audience      String[]  @map("audience")
  scheduledDate DateTime? @map("scheduled_date")
  status        String    @default("Sent") @map("status") // Sent, Scheduled, Draft
  sentCount     Int       @default(0) @map("sent_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("broadcast_notifications")
}

model SupportTicket {
  id         String   @id @default(cuid())
  subject    String   @map("subject")
  message    String   @map("message")
  fromName   String   @map("from_name")
  fromType   String   @map("from_type") // Business, Customer
  status     String   @default("Open") @map("status") // Open, Resolved, Escalated
  priority   String   @default("Medium") @map("priority") // Low, Medium, High
  assignedTo String?  @map("assigned_to")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   @map("action")
  adminName  String   @map("admin_name")
  targetType String   @map("target_type")
  targetName String   @map("target_name")
  details    String   @map("details")
  timestamp  DateTime @default(now()) @map("timestamp")
  category   String   @map("category")

  @@map("audit_logs")
}

model SystemSettings {
  id                    String   @id @default("global") @map("id")
  brandName             String   @default("MCOMSolutions") @map("brand_name")
  supportEmail          String   @default("support@mcomsolutions.co.uk") @map("support_email")
  currency              String   @default("GBP") @map("currency")
  sessionTimeout        Int      @default(60) @map("session_timeout")
  maxLoginAttempts      Int      @default(5) @map("max_login_attempts")
  emailEnabled          Boolean  @default(true) @map("email_enabled")
  smsEnabled            Boolean  @default(false) @map("sms_enabled")
  paymentGateway        String   @default("Stripe") @map("payment_gateway")
  maintenanceMode      Boolean  @default(false) @map("maintenance_mode")
  allowRegistration    Boolean  @default(true) @map("allow_registration")
  authConfig            Json?    @map("auth_config")
  registrationFlow      Json?    @map("registration_flow")
  businessProfileConfig Json?    @map("business_profile_config")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model PlatformLaunchRule {
  id                  String   @id @default(cuid())
  platformId          String   @map("platform_id")
  requiredMembership  String   @map("required_membership")
  requiredPackage     String   @map("required_package")
  requiredPermissions String[] @map("required_permissions")
  launchConditions    String   @map("launch_conditions")
  redirectRule        String   @map("redirect_rule")
  accessRule          String   @map("access_rule")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("platform_launch_rules")
}

model SystemIntegration {
  id            String    @id @default(cuid())
  name          String    @map("name")
  type          String    @map("type")
  status        String    @map("status") // Connected, Disconnected, Error
  lastSync      DateTime? @map("last_sync")
  connectedDate DateTime? @map("connected_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("system_integrations")
}

model SystemApiKey {
  id          String    @id @default(cuid())
  name        String    @map("name")
  key         String    @unique @map("key") // last 4 chars (suffix) for display
  keyHash     String    @unique @map("key_hash") // SHA-256 of the raw key (for verification)
  permissions String[]  @map("permissions")
  status      String    @default("Active") @map("status") // Active, Revoked
  lastUsed    DateTime? @map("last_used")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("system_api_keys")
}

model RevenueRecord {
  id        String   @id @default(cuid())
  date      String   @map("date") // YYYY-MM-DD
  amount    Float    @map("amount")
  type      String   @map("type")
  source    String   @map("source")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("revenue_records")
}

model Borough {
  id                   String   @id @default(cuid())
  name                 String   @unique @map("name")
  populationActivity   String   @map("population_activity")
  businessCount        Int      @default(0) @map("business_count")
  activeCampaigns      Int      @default(0) @map("active_campaigns")
  rewardsParticipation String   @map("rewards_participation")
  healthScore          Int      @map("health_score")
  manager              String   @map("manager")
  area                 String   @map("area")
  region               String   @map("region")
  engagement           String   @map("engagement")
  health               String   @map("health")
  activity             String   @map("activity")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  metrics              BoroughMetric[]

  @@map("boroughs")
}

model HighStreet {
  id            String   @id @default(cuid())
  name          String   @map("name")
  borough       String   @map("borough")
  status        String   @default("Active") @map("status")
  businessCount Int      @default(0) @map("business_count")
  lat           Float?   @map("lat")
  lng           Float?   @map("lng")
  assignedTo    String?  @map("assigned_to")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  activities    ActivityFeed[]

  @@map("high_streets")
}

model LocalMall {
  id                                  String   @id @default(cuid())
  name                                String   @map("name")
  postcodes                           String[] @map("postcodes")
  borough                             String   @map("borough")
  primaryHighStreet                   String   @map("primary_high_street")
  additionalHighStreets               String[] @map("additional_high_streets")
  businesses                          Int      @default(0) @map("businesses")
  customers                           Int      @default(0) @map("customers")
  campaigns                           Int      @default(0) @map("campaigns")
  events                              Int      @default(0) @map("events")
  status                              String   @default("Active") @map("status") // Active, Draft, Disabled, Archived
  createdDate                         DateTime @default(now()) @map("created_date")
