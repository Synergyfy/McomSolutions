enum AccessPassCodeStatus {
  PENDING_PAYMENT
  UNUSED
  REDEEMED
  REVOKED
}

// A paid-but-not-yet-activated access pass. Codes are created either for a
// recipient email (gift) or as a transferable code. They are only redeemed
// after payment completes and expiry starts at redemption time.
model AccessPassCode {
  id                   String               @id @default(cuid())
  code                 String               @unique
  accessPlanId         String               @map("access_plan_id")
  accessPlan           AccessPlan           @relation(fields: [accessPlanId], references: [id], onDelete: Restrict)
  // Nullable: partner/platform-issued codes have no purchaser business.
  purchaserBusinessId  String?              @map("purchaser_business_id")
  purchaserUserId      String?              @map("purchaser_user_id")
  recipientEmail       String?              @map("recipient_email")
  mode                 String               @default("CODE") // GIFT | CODE
  status               AccessPassCodeStatus @default(PENDING_PAYMENT)
  amount               Float                @default(0)
  currency             String               @default("GBP")
  provider             String?
  providerPaymentId    String?              @unique @map("provider_payment_id")
  // Partner provenance (e.g. sourceApp="mcom-rewards", externalRef=<issuanceId>).
  sourceApp            String?              @map("source_app")
  externalRef          String?              @map("external_ref")
  purchasedAt          DateTime?            @map("purchased_at")
  emailSentAt          DateTime?            @map("email_sent_at")
  redeemedAt           DateTime?            @map("redeemed_at")
  redeemedByBusinessId String?              @map("redeemed_by_business_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@unique([sourceApp, externalRef])
  @@index([purchaserBusinessId])
  @@index([recipientEmail])
  @@index([status])
  @@map("access_pass_codes")
}

model MembershipInstallmentSubscription {
  // Recurring (pay-as-you-go, auto-charged) membership state.
  // businessId is intentionally FK-free (same precedent as
  // EcosystemSubscription) — legacy/dashboard rows may carry non-FK ids.
  businessId           String                  @map("business_id")
  tierId               String                  @map("tier_id")
  paymentOptionId      String                  @map("payment_option_id")
  paymentOption        MembershipPaymentOption @relation(fields: [paymentOptionId], references: [id])
  id                   String                  @id @default(cuid())
  installmentsTotal    Int                     @map("installments_total")
  installmentsPaid     Int                     @default(0) @map("installments_paid")
  status               String                  @default("active") @map("status")
  stripeSubscriptionId String?                 @unique @map("stripe_subscription_id")
  paypalSubscriptionId String?                 @unique @map("paypal_subscription_id")
  currentPeriodEnd     DateTime?               @map("current_period_end")
  nextDueAt            DateTime?               @map("next_due_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@index([status, nextDueAt])
  @@map("membership_installment_subscriptions")
}

// ─── RECURRING BILLING MANDATES ──────────────────────────────────────────────
// One row per auto-renewing agreement. Stripe/PayPal charge at the provider;
// the local scheduler only reconciles + extends entitlements (and handles
// wallet debits, where MCOM is the actual charger). `scope_key` is a stable
// natural key so a business can never hold two mandates for the same target.

enum RecurringScope {
  MEMBERSHIP
  PLATFORM
}

enum RecurringProvider {
  stripe
  paypal
  wallet
}

enum RecurringStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum RecurringChargeStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model RecurringSubscription {
  id         String         @id @default(cuid())
  scopeKey   String         @unique @map("scope_key")
  scope      RecurringScope
  businessId String         @map("business_id")
  userId     String?        @map("user_id")

  // Membership target
  membershipPlanId   String? @map("membership_plan_id")
  membershipPlanName String? @map("membership_plan_name")
  membershipTier     String? @map("membership_tier")
  level              String? @map("level")

  // Platform target
  platform       String?
  externalPlanId String? @map("external_plan_id")

  // Provider linkage
  provider                RecurringProvider
  providerCustomerId      String?           @map("provider_customer_id")
  providerSubscriptionId  String?           @unique @map("provider_subscription_id")
  providerPriceId         String?           @map("provider_price_id")
  providerPaymentIntentId String?           @unique @map("provider_payment_intent_id")

  // Terms
  planName      String @map("plan_name")
  billingCycle  String @map("billing_cycle")
  intervalUnit  String @default("month") @map("interval_unit")
  intervalCount Int    @default(1) @map("interval_count")
  amount        Float
  currency      String @default("GBP")

  // Lifecycle
  status             RecurringStatus @default(INCOMPLETE)
  autoRenew          Boolean         @default(true) @map("auto_renew")
  cancelAtPeriodEnd  Boolean         @default(false) @map("cancel_at_period_end")
  currentPeriodStart DateTime?       @map("current_period_start")
  currentPeriodEnd   DateTime?       @map("current_period_end")
  nextChargeAt       DateTime?       @map("next_charge_at")
  graceDays          Int             @default(3) @map("grace_days")
  retryCount         Int             @default(0) @map("retry_count")
  lastAttemptAt      DateTime?       @map("last_attempt_at")
  lastError          String?         @map("last_error")
  metadata           Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  charges RecurringCharge[]

  @@index([status, nextChargeAt])
  @@index([businessId, scope])
  @@index([provider, status])
  @@map("recurring_subscriptions")
}

model RecurringCharge {
  id             String                @id @default(cuid())
  subscriptionId String                @map("subscription_id")
  subscription   RecurringSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  periodStart       DateTime              @map("period_start")
  periodEnd         DateTime              @map("period_end")
  amount            Float
  currency          String                @default("GBP")
  status            RecurringChargeStatus @default(PENDING)
  attempt           Int                   @default(1)
  idempotencyKey    String                @unique @map("idempotency_key")
  providerInvoiceId String?               @unique @map("provider_invoice_id")
  providerPaymentId String?               @unique @map("provider_payment_id")
  error             String?
  paidAt            DateTime?             @map("paid_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  @@unique([subscriptionId, periodStart])
  @@index([status, createdAt])
  @@map("recurring_charges")
}

// ─── COUPONS (admin codes + task rewards) ────────────────────────────────────
// A coupon is redeemable against a membership payment. Task rewards are
// issued as personal, single-use coupons locked to the completing user.
// `times_redeemed` is a denormalised completed-redemption counter for fast
// list/status filters; the CouponRedemption ledger remains the audit source.

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponSource {
  ADMIN
  TASK_REWARD
}

enum CouponRedemptionStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum CouponProductType {
  MEMBERSHIP
  ACCESS
}

model Coupon {
  id                      String              @id @default(cuid())
  code                    String              @unique
  description             String?
  discountType            CouponDiscountType  @map("discount_type")
  discountValue           Float               @map("discount_value")
  appliesToAllMemberships Boolean             @default(true) @map("applies_to_all_memberships")
  appliesToAllAccess      Boolean             @default(false) @map("applies_to_all_access")
  maxUses                 Int?                @map("max_uses")
  maxUsesPerUser          Int?                @default(1) @map("max_uses_per_user")
  timesRedeemed           Int                 @default(0) @map("times_redeemed")
  validFrom               DateTime            @default(now()) @map("valid_from")
  expiresAt               DateTime?           @map("expires_at")
  isActive                Boolean             @default(true) @map("is_active")
  source                  CouponSource        @default(ADMIN)
  // Partner provenance (e.g. sourceApp="mcom-rewards", externalRef=<issuanceId>).
  sourceApp               String?             @map("source_app")
  externalRef             String?             @map("external_ref")
  // Set once the expiry lifecycle event has been emitted (idempotent sweep).
  expiryEventSentAt       DateTime?           @map("expiry_event_sent_at")
  lockedToUserId          String?             @map("locked_to_user_id")
  lockedToUser            User?               @relation("CouponLockedToUser", fields: [lockedToUserId], references: [id], onDelete: SetNull)
  taskDefinitionId        String?             @map("task_definition_id")
  taskDefinition          TaskDefinition?     @relation(fields: [taskDefinitionId], references: [id], onDelete: SetNull)
  taskAssignmentId        String?             @unique @map("task_assignment_id")
  taskAssignment          UserTaskAssignment? @relation(fields: [taskAssignmentId], references: [id], onDelete: SetNull)
  createdByName           String?             @map("created_by_name")
  emailSentAt             DateTime?           @map("email_sent_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  membershipPlans CouponMembershipPlan[]
  accessPlans     CouponAccessPlan[]
  redemptions     CouponRedemption[]

  @@index([isActive, validFrom, expiresAt])
  @@index([source])
  @@index([sourceApp, externalRef])
  @@index([lockedToUserId])
  @@index([taskDefinitionId])
  @@map("coupons")
}

model CouponMembershipPlan {
  couponId String         @map("coupon_id")
  planId   String         @map("plan_id")
  coupon   Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([couponId, planId])
  @@index([planId])
  @@map("coupon_membership_plans")
}

model CouponAccessPlan {
  couponId     String     @map("coupon_id")
  accessPlanId String     @map("access_plan_id")
  coupon       Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  accessPlan   AccessPlan @relation(fields: [accessPlanId], references: [id], onDelete: Cascade)

  @@id([couponId, accessPlanId])
  @@index([accessPlanId])
  @@map("coupon_access_plans")
}

model CouponRedemption {
  id                   String                 @id @default(cuid())
  couponId             String                 @map("coupon_id")
  coupon               Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponCode           String                 @map("coupon_code")
  userId               String?                @map("user_id")
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessId           String?                @map("business_id")
  business             BusinessProfile?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  planId               String?                @map("plan_id")
  plan                 MembershipPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName             String?                @map("plan_name")
  productType          CouponProductType      @default(MEMBERSHIP) @map("product_type")
  accessPlanId         String?                @map("access_plan_id")
  accessPlan           AccessPlan?            @relation(fields: [accessPlanId], references: [id], onDelete: SetNull)
  accessPlanName       String?                @map("access_plan_name")
  billingTransactionId String?                @unique @map("billing_transaction_id")
  provider             String?
  providerPaymentId    String?                @map("provider_payment_id")
  originalAmount       Float                  @map("original_amount")
  discountAmount       Float                  @map("discount_amount")
  finalAmount          Float                  @map("final_amount")
  status               CouponRedemptionStatus @default(PENDING)
  reservedUntil        DateTime?              @map("reserved_until")
  redeemedAt           DateTime?              @map("redeemed_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@index([couponId, status, reservedUntil])
  @@index([userId, couponId, status])
  @@index([status, reservedUntil])
  @@index([businessId])
  @@index([planId])
  @@index([accessPlanId])
  @@index([redeemedAt])
  @@map("coupon_redemptions")
}

// Task reward coupon scope (specific membership plans selected on a task).
model TaskRewardCouponPlan {
  taskId String         @map("task_id")
  planId String         @map("plan_id")
  task   TaskDefinition @relation(fields: [taskId], references: [id], onDelete: Cascade)
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([taskId, planId])
  @@index([planId])
  @@map("task_reward_coupon_plans")
}

// Task reward coupon scope for access plans.
model TaskRewardCouponAccessPlan {
  taskId       String         @map("task_id")
  accessPlanId String         @map("access_plan_id")
  task         TaskDefinition @relation(fields: [taskId], references: [id], onDelete: Cascade)
  accessPlan   AccessPlan     @relation(fields: [accessPlanId], references: [id], onDelete: Cascade)

  @@id([taskId, accessPlanId])
  @@index([accessPlanId])
  @@map("task_reward_coupon_access_plans")
}

