  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([role])
  @@map("support_agents")
}

// ─── TASK ENGINE (/admin/programme) ──────────────────────────────────────────

enum TaskAudience {
  BUSINESS
  CUSTOMER
  BOTH
}

enum TaskAssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum TaskSource {
  INTERNAL
  EXTERNAL
}

enum TaskAccessScope {
  ALL
  PAID
  TRIAL
}

enum TaskSubmissionType {
  AUTO
  EXTERNAL_LINK
  TEXT_INPUT
  DIGIT_INPUT
  IMAGE_UPLOAD
}

model TaskDefinition {
  id                             String                       @id @default(cuid())
  title                          String                       @map("title")
  description                    String                       @map("description")
  targetAudience                 TaskAudience                 @default(BOTH) @map("target_audience")
  accessScope                    TaskAccessScope              @default(ALL) @map("access_scope")
  submissionType                 TaskSubmissionType           @default(AUTO) @map("submission_type")
  // Admin-supplied destination for EXTERNAL_LINK tasks on MCOM Central: the
  // user opens this link from the dashboard, then confirms completion.
  actionUrl                      String?                      @map("action_url")
  actionLabel                    String?                      @map("action_label")
  featureKey                     String?                      @map("feature_key")
  taskSource                     TaskSource                   @default(INTERNAL) @map("task_source")
  externalClientId               String?                      @map("external_client_id")
  externalAppName                String?                      @map("external_app_name")
  externalPlatformSlug           String?                      @map("external_platform_slug")
  externalAppUrl                 String?                      @map("external_app_url")
  deadlineDays                   Int                          @default(7) @map("deadline_days")
  rewardPoints                   Int                          @default(0) @map("reward_points")
  // Optional completion reward: a personal single-use coupon issued when the
  // assignment is completed (user, admin, or event worker).
  rewardCouponEnabled            Boolean                      @default(false) @map("reward_coupon_enabled")
  rewardCouponDiscountType       CouponDiscountType?          @map("reward_coupon_discount_type")
  rewardCouponValue              Float?                       @map("reward_coupon_value")
  rewardCouponAppliesToAll       Boolean                      @default(true) @map("reward_coupon_applies_to_all")
  rewardCouponAppliesToAllAccess Boolean                      @default(false) @map("reward_coupon_applies_to_all_access")
  rewardCouponValidDays          Int?                         @map("reward_coupon_valid_days")
  rewardCouponExpiresAt          DateTime?                    @map("reward_coupon_expires_at")
  isActive                       Boolean                      @default(true) @map("is_active")
  platform                       String                       @default("mcom_central") @map("platform")
  createdAt                      DateTime                     @default(now()) @map("created_at")
  updatedAt                      DateTime                     @updatedAt @map("updated_at")
  assignments                    UserTaskAssignment[]
  rewardCouponPlans              TaskRewardCouponPlan[]
  rewardCouponAccessPlans        TaskRewardCouponAccessPlan[]
  issuedCoupons                  Coupon[]
  affiliateTasks                 AffiliateTask[]

  @@index([featureKey])
  @@index([isActive])
  @@index([taskSource])
  @@index([externalClientId])
  @@index([rewardCouponEnabled])
  @@map("task_definitions")
}

model UserTaskAssignment {
  id             String               @id @default(cuid())
  taskId         String               @map("task_id")
  task           TaskDefinition       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String               @map("user_id")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userType       Role                 @map("user_type")
  status         TaskAssignmentStatus @default(PENDING) @map("status")
  assignedAt     DateTime             @default(now()) @map("assigned_at")
  deadlineAt     DateTime             @map("deadline_at")
  completedAt    DateTime?            @map("completed_at")
  rewardGranted  Boolean              @default(false) @map("reward_granted")
  rewardPoints   Int                  @default(0) @map("reward_points")
  submissionData Json?                @map("submission_data")
  rewardCoupon   Coupon?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@index([status])
  @@index([deadlineAt])
  @@map("user_task_assignments")
}

