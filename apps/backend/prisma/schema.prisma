// ─── CENTRALIZED WALLET SYSTEM ────────────────────────────────────────────────

enum WalletStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionCategory {
  TOP_UP
  REWARD
  REFUND
  ADMIN_CREDIT
  TRANSFER_IN
  SUBSCRIPTION
  PURCHASE
  SERVICE_FEE
  ADMIN_DEBIT
  TRANSFER_OUT
  HOLD_CAPTURE
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REVERSED
}

enum HoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

enum TopUpStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Wallet {
  id       String       @id @default(cuid())
  userId   String       @unique @map("user_id")
  balance  Decimal      @default(0) @map("balance") @db.Decimal(18, 4)
  currency String       @default("MCOM") @map("currency")
  status   WalletStatus @default(ACTIVE) @map("status")

  dailyDebitLimit   Decimal? @map("daily_debit_limit") @db.Decimal(18, 4)
  monthlyDebitLimit Decimal? @map("monthly_debit_limit") @db.Decimal(18, 4)
  maxBalance        Decimal? @map("max_balance") @db.Decimal(18, 4)

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastTransactionAt DateTime? @map("last_transaction_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
  holds         WalletHold[]
  topUpRequests WalletTopUpRequest[]
  auditLogs     WalletAuditLog[]

  @@index([userId])
  @@index([status])
  @@map("wallets")
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String @map("wallet_id")

  type          TransactionType @map("type")
  amount        Decimal         @map("amount") @db.Decimal(18, 4)
  balanceBefore Decimal         @map("balance_before") @db.Decimal(18, 4)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(18, 4)
  currency      String          @default("MCOM") @map("currency")

  platformClientId String? @map("platform_client_id")
  platformName     String? @map("platform_name")
  platformSlug     String? @map("platform_slug")

  category    TransactionCategory @map("category")
  reference   String?             @map("reference")
  description String?             @map("description")
  metadata    Json?               @map("metadata")

  idempotencyKey String? @unique @map("idempotency_key")

  status        TransactionStatus @default(COMPLETED) @map("status")
  failureReason String?           @map("failure_reason")
  holdId        String?           @map("hold_id")
  initiatedBy   String?           @map("initiated_by")
  ipAddress     String?           @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  hold   WalletHold? @relation(fields: [holdId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([walletId, createdAt(sort: Desc)])
  @@index([platformClientId])
  @@index([platformSlug])
  @@index([category])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([idempotencyKey])
  @@index([reference])
  @@index([status])
  @@index([walletId, platformSlug, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model WalletHold {
  id               String     @id @default(cuid())
  walletId         String     @map("wallet_id")
  amount           Decimal    @map("amount") @db.Decimal(18, 4)
  platformClientId String     @map("platform_client_id")
  platformName     String     @map("platform_name")
  reference        String?    @map("reference")
  description      String?    @map("description")
  status           HoldStatus @default(ACTIVE) @map("status")
  expiresAt        DateTime   @map("expires_at")
  capturedAt       DateTime?  @map("captured_at")
  releasedAt       DateTime?  @map("released_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  wallet       Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([walletId])
  @@index([platformClientId])
  @@index([expiresAt])
  @@index([status])
  @@index([status, expiresAt])
  @@map("wallet_holds")
}

model WalletAuditLog {
  id        String   @id @default(cuid())
  walletId  String   @map("wallet_id")
  adminId   String   @map("admin_id")
  action    String   @map("action")
  reason    String   @map("reason")
  changes   Json?    @map("changes")
  ip        String?  @map("ip")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([adminId])
  @@index([createdAt(sort: Desc)])
  @@map("wallet_audit_logs")
}

model WalletTopUpRequest {
  id             String  @id @default(cuid())
  walletId       String  @map("wallet_id")
  userId         String  @map("user_id")
  amount         Decimal @map("amount") @db.Decimal(18, 4)
  currency       String  @default("GBP") @map("currency")
  walletCurrency String  @default("MCOM") @map("wallet_currency")
  exchangeRate   Decimal @default(1) @map("exchange_rate") @db.Decimal(10, 6)

  provider       String  @map("provider")
  providerRef    String? @unique @map("provider_ref")
  providerStatus String? @map("provider_status")

  status        TopUpStatus @default(PENDING) @map("status")
  transactionId String?     @map("transaction_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([providerRef])
  @@index([status])
  @@map("wallet_top_up_requests")
}

// ─── FX RATES (wallet top-up conversion) ────────────────────────────────────
// Base → quote pair, seeded from env (MCOM_GBP_RATE) and updatable at runtime.

model FxRate {
  id        String   @id @default(cuid())
  base      String   @map("base") // e.g. 'GBP'
  quote     String   @map("quote") // e.g. 'MCOM'
  rate      Decimal  @map("rate") @db.Decimal(10, 6)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([base, quote])
  @@map("fx_rates")
}

// ─── PROGRAMME & SYSTEM SETTINGS ────────────────────────────────────────────

model ProgrammeSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("programme_settings")
}

// ─── RELATIONAL PLAN FAMILY & TIER ARCHITECTURE — REMOVED ──────────────────────
// MCOM holds no plans of its own (memberships-only model). Memberships
// (membership_plans) bundle plans/packages that live on console-registered
// external platforms (see admin/console + external_plans mirror). The former
// Tier/Plan/PlanVariant/PlanPrice/Subscription tables were dropped in
// migration 20261006030000_drop_tier_plan_package_tables; tiers survive as
// Standard/Pro/Pro+ values in tier* JSON columns and tier-duration utils.

// ─── ENTERPRISE REAL-TIME CHAT & MESSAGING SYSTEM ────────────────────────────

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

model Conversation {
  id                  String           @id @default(uuid())
  type                ConversationType @default(DIRECT)
  title               String? // For group conversations
  avatarUrl           String?          @map("avatar_url")
  directKey           String?          @unique @map("direct_key") // canonical sorted "userIdA:userIdB"
  createdById         String?          @map("created_by_id")
  createdBy           User?            @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastMessageAt       DateTime         @default(now()) @map("last_message_at")
  lastMessageText     String?          @map("last_message_text")
  lastMessageSenderId String?          @map("last_message_sender_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@index([deletedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id                String          @id @default(uuid())
  conversationId    String          @map("conversation_id")
  conversation      Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              ParticipantRole @default(MEMBER)
  isMuted           Boolean         @default(false) @map("is_muted")
  lastReadMessageId String?         @map("last_read_message_id")
  lastReadAt        DateTime?       @map("last_read_at")
  joinedAt          DateTime        @default(now()) @map("joined_at")
  leftAt            DateTime?       @map("left_at")

  @@unique([conversationId, userId])
  @@index([userId, isMuted])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  idempotencyKey String?      @map("idempotency_key")
  type           String       @default("TEXT") // TEXT, SYSTEM, IMAGE, FILE
  content        String       @db.Text
  metadata       Json?
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  readReceipts MessageReadReceipt[]

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now()) @map("read_at")

  @@unique([messageId, userId])
  @@index([messageId, readAt])
  @@index([userId])
  @@map("message_read_receipts")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  directMessages Boolean  @default(true) @map("direct_messages")
  groupMessages  Boolean  @default(true) @map("group_messages")
  pushEnabled    Boolean  @default(true) @map("push_enabled")
  emailEnabled   Boolean  @default(true) @map("email_enabled")
  dndEnabled     Boolean  @default(false) @map("dnd_enabled")
  dndStartTime   String?  @map("dnd_start_time")
  dndEndTime     String?  @map("dnd_end_time")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model ChatOutbox {
  id           String    @id @default(uuid())
  eventType    String    @map("event_type") // NEW_MESSAGE, PUSH_DISPATCH, READ_SYNC
  payload      Json
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  retryCount   Int       @default(0) @map("retry_count")
  errorMessage String?   @map("error_message")
  processedAt  DateTime? @map("processed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("chat_outbox")
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ChatMessageRequest {
  id             String               @id @default(uuid())
  senderId       String               @map("sender_id")
  sender         User                 @relation("MessageRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String               @map("receiver_id")
  receiver       User                 @relation("MessageRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  status         MessageRequestStatus @default(PENDING)
  message        String?              @db.Text
  rejectionCount Int                  @default(0) @map("rejection_count")
  respondedAt    DateTime?            @map("responded_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("chat_message_requests")
}

model ChatBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blocker   User     @relation("UserBlocksSent", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id")
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("chat_blocks")
}
