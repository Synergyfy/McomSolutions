datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUSINESS
  CUSTOMER
  ADMIN
  AGENT
  CONSULTANT
  ACCOUNT_MANAGER
  PARTNER
}

enum MembershipLevel {
  Bronze
  Silver
  Gold
  Platinum
}

enum MembershipTier {
  Free
  Normal
  Pro
  ProPlus @map("Pro+")
}

enum MembershipStatus {
  active
  inactive
  trial
  past_due
}

model User {
  id                              String                     @id @default(uuid())
  email                           String                     @unique
  password                        String
  role                            Role                       @default(BUSINESS)
  firstName                       String?
  lastName                        String?
  jobTitle                        String?                    @default("Managing Director")
  twoFactorEnabled                Boolean                    @default(false)
  emailNotifications              Boolean                    @default(true)
  smsNotifications                Boolean                    @default(false)
  registrationSource              String?                    @default("direct")
  adminRole                       String?
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  deletedAt                       DateTime?                  @map("deleted_at")
  // Phase 3: session version — bumped on password reset / role change / ban-deactivate.
  // Outstanding access tokens carry `tv` and are rejected when it mismatches.
  tokenVersion                    Int                        @default(0) @map("token_version")
  referralCode                    String?                    @unique @map("referral_code")
  referredById                    String?                    @map("referred_by_id")
  referredBy                      User?                      @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                       User[]                     @relation("Referrals")
  businessProfile                 BusinessProfile?
  customerProfile                 CustomerProfile?
  agentProfile                    AgentProfile?
  consultantProfile               ConsultantProfile?
  accountManagerProfile           AccountManagerProfile?
  ssoSessions                     SsoSession[]
  refreshSessions                 RefreshSession[]
  resetCodes                      PasswordResetCode[]
  wallet                          Wallet?
  walletTopUps                    WalletTopUpRequest[]
  taskAssignments                 UserTaskAssignment[]
  lockedCoupons                   Coupon[]                   @relation("CouponLockedToUser")
  couponRedemptions               CouponRedemption[]
  conversationsCreated            Conversation[]             @relation("ConversationCreator")
  conversationMemberships         ConversationParticipant[]
  sentMessages                    Message[]                  @relation("MessageSender")
  messageReadReceipts             MessageReadReceipt[]
  pushSubscriptions               PushSubscription[]
  notificationPreference          NotificationPreference?
  messageRequestsSent             ChatMessageRequest[]       @relation("MessageRequestsSent")
  messageRequestsReceived         ChatMessageRequest[]       @relation("MessageRequestsReceived")
  blocksSent                      ChatBlock[]                @relation("UserBlocksSent")
  blocksReceived                  ChatBlock[]                @relation("UserBlocksReceived")
  // ── Affiliate collaboration (account managers, delegated tasks, reputation) ──
  managedBusinesses               BusinessProfile[]          @relation("BusinessAccountManager")
  affiliateTasksAssigned          AffiliateTask[]            @relation("AffiliateTaskAssignee")
  affiliateTasksCreated           AffiliateTask[]            @relation("AffiliateTaskCreator")
  affiliateTasksAssignedBy        AffiliateTask[]            @relation("AffiliateTaskAssignedByAdmin")
  affiliateReviewsGiven           AffiliateTaskReview[]      @relation("AffiliateTaskReviewer")
  reputationEvents                AffiliateReputationEvent[]
  ratingsReceived                 AffiliateRating[]          @relation("AffiliateRatingTarget")
  ratingsCreated                  AffiliateRating[]          @relation("AffiliateRatingCreatedBy")
  reportsReceived                 AffiliateReport[]          @relation("AffiliateReportTarget")
  reportsReviewed                 AffiliateReport[]          @relation("AffiliateReportReviewer")
  // ── Projects, service requests and task audit trail ──
  managedAffiliateProjects        AffiliateProject[]         @relation("AffiliateProjectManager")
  createdAffiliateProjects        AffiliateProject[]         @relation("AffiliateProjectCreator")
  affiliateServiceRequestsOwned   AffiliateServiceRequest[]  @relation("AffiliateServiceRequestManager")
  affiliateServiceRequestsCreated AffiliateServiceRequest[]  @relation("AffiliateServiceRequestCreator")
  affiliateTaskEvents             AffiliateTaskEvent[]       @relation("AffiliateTaskEventActor")

  @@index([deletedAt])
  @@index([role])
  @@index([referredById])
}

model BusinessProfile {
  id                       String                    @id @default(uuid())
  userId                   String                    @unique
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName             String
  businessType             String
  country                  String
  phone                    String
  email                    String
  isOnGoogle               Boolean                   @default(false)
  googlePlaceId            String?
  address                  String?
  postcode                 String?
  industry                 String?
  category                 String?
  subCategory              String?
  description              String?
  website                  String?
  logoUrl                  String?
  openingHours             String?
  socialMedia              String?
  membershipLevel          MembershipLevel           @default(Bronze)
  membershipTier           MembershipTier            @default(Normal)
  membershipStatus         MembershipStatus          @default(active)
  membershipPlanName       String?                   @map("membership_plan_name")
  membershipExpiresAt      DateTime?                 @map("membership_expires_at")
  // Recurring billing linkage. Loose ids on purpose (same precedent as
  // EcosystemSubscription): historical rows may not have a matching record.
  membershipRecurringId    String?                   @map("membership_recurring_id")
  stripeCustomerId         String?                   @map("stripe_customer_id")
  paypalPayerId            String?                   @map("paypal_payer_id")
  hasPaidVerificationFee   Boolean                   @default(false) @map("has_paid_verification_fee")
  verificationFeePaidAt    DateTime?                 @map("verification_fee_paid_at")
  trialAccessDays          Int                       @default(14) @map("trial_access_days")
  trialAccessExpiresAt     DateTime?                 @map("trial_access_expires_at")
  apiKey                   String?                   @unique
  localMallName            String?
  localMallId              String?
  proximityTier            String?                   @default("national") // high_street, national
  // ─── Location hierarchy assignment (auto-resolved from UK postcode) ───
  cityId                   String?                   @map("city_id")
  city                     City?                     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  boroughId                String?                   @map("borough_id")
  borough                  Borough?                  @relation(fields: [boroughId], references: [id], onDelete: SetNull)
  highStreetId             String?                   @map("high_street_id")
  highStreet               HighStreet?               @relation(fields: [highStreetId], references: [id], onDelete: SetNull)
  localMall                LocalMall?                @relation(fields: [localMallId], references: [id], onDelete: SetNull)
  sectorId                 String?                   @map("sector_id")
  sector                   Sector?                   @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  categoryId               String?                   @map("category_id")
  categoryRef              Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId            String?                   @map("sub_category_id")
  subCategoryRef           SubCategory?              @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  locationAssignedAt       DateTime?                 @map("location_assigned_at")
  // ── Account manager assignment (membership subscribers only) ──
  accountManagerId         String?                   @map("account_manager_id")
  accountManager           User?                     @relation("BusinessAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  accountManagerAssignedAt DateTime?                 @map("account_manager_assigned_at")
  // ── Business acquisition & attribution (247GBS Affiliates) ──
  // These fields are intentionally separate from accountManagerId: the
  // affiliate who introduced a business and the manager who runs the
  // relationship are distinct roles and may be different people.
  acquiredByAffiliateId         String?                          @map("acquired_by_affiliate_id")
  acquiredByAffiliateExternalId String?                          @map("acquired_by_affiliate_external_id")
  acquiredByAffiliateName       String?                          @map("acquired_by_affiliate_name")
  acquiredByAffiliateRole       String?                          @map("acquired_by_affiliate_role")
  onboardedByAffiliateId        String?                          @map("onboarded_by_affiliate_id")
  acquisitionSource             String?                          @default("direct") @map("acquisition_source")
  acquisitionInvitationId       String?                          @map("acquisition_invitation_id")
  acquisitionStatus             AffiliateBusinessAcquisitionStatus? @map("acquisition_status")
  acquisitionAttributedAt       DateTime?                        @map("acquisition_attributed_at")
  acquisitionVerifiedAt         DateTime?                        @map("acquisition_verified_at")
  acquisitionVerifiedByUserId   String?                          @map("acquisition_verified_by_user_id")
  relationshipHistory           BusinessRelationshipHistory[]
  affiliateInvitations          AffiliateBusinessInvitation[]
  packages                 PlatformPackage[]
  transactions             BillingTransaction[]
  notifications            Notification[]
  supportTickets           SupportTicket[]
  couponRedemptions        CouponRedemption[]
  accessPurchases          AccessPurchase[]
  whitelabelAccess         WhitelabelAccess[]
  affiliateTasks           AffiliateTask[]
  affiliateProjects        AffiliateProject[]
  affiliateServiceRequests AffiliateServiceRequest[]
  affiliateRatings         AffiliateRating[]
  affiliateReports         AffiliateReport[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?                 @map("deleted_at")

  @@index([deletedAt])
  @@index([membershipExpiresAt])
  @@index([localMallId])
  @@index([membershipStatus])
  @@index([accountManagerId])
  @@index([acquiredByAffiliateId])
  @@index([acquiredByAffiliateExternalId])
  @@index([acquisitionStatus])
  @@index([cityId])
  @@index([boroughId])
  @@index([highStreetId])
  @@index([sectorId])
  @@index([categoryId])
  @@index([subCategoryId])
}

model Notification {
  id         String           @id @default(uuid())
  businessId String?
  business   BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Phase 4: user-scoped delivery. Plain (non-FK) string on purpose — deleting
  // a user must not cascade-delete their notification history (audit trail).
  userId     String?          @map("user_id")
  type       String // membership, package, update, payment, announcement
  title      String
  message    String
  read       Boolean          @default(false)
  data       Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId])
  @@index([businessId, read, createdAt])
}

model PlatformPackage {
  id                     String          @id @default(uuid())
  businessId             String
  business               BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform               String // MCOM Mall, MCOM Rewards, MCOM Spin, GBS Audit, GBS Expo
  packageName            String // Starter, Standard, Enterprise, or plan name from external service
  status                 String          @default("active") // active, inactive, expired
  limits                 Json? // JSON holding keys like rewardsLimit, campaignsLimit, etc.
  externalPlanId         String? // Plan ID from external service (Mall/Rewards)
  planName               String? // Display name from external plan
  planType               String? // STANDARD, TRIAL, SEASONAL
  expiresAt              DateTime? // When the subscription expires (null = no expiry)
  provider               String? // 'stripe' or 'paypal'
  providerSubscriptionId String? // Stripe subscription ID or PayPal subscription ID
  autoRenew              Boolean         @default(false) @map("auto_renew")
  nextChargeAt           DateTime?       @map("next_charge_at")
  amount                 Float? // Amount paid
  currency               String          @default("GBP")
  billingCycle           String? // monthly, quarterly, annual
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([businessId, platform])
  @@index([externalPlanId])
  @@index([expiresAt])
}

model BillingTransaction {
  id                String          @id @default(uuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount            Float
  description       String
  status            String          @default("paid") // paid, pending, failed, refunded
  platformPackageId String? // Link to platform package purchased
  provider          String? // 'stripe' or 'paypal'
  providerPaymentId String?         @unique // Stripe payment intent ID or PayPal order ID (idempotency key)
  // Partner grants persist list price / original amount / issuance metadata here
  // while the ledger amount stays 0 (reward-funded). Additive + nullable.
  metadata          Json?           @map("metadata")
  createdAt         DateTime        @default(now())

  @@index([platformPackageId])
  @@index([businessId, status])
  @@index([createdAt])
  @@index([businessId, status, createdAt])
}

// Phase 2 (G1): PayPal capture outbox. When the upstream capture succeeds but
// the local activation write fails, the activation intent is parked here and
// retried by cron — money is never silently dropped.
model PaymentOutbox {
  id                String   @id @default(uuid())
  provider          String   @default("paypal")
  providerPaymentId String   @unique
  kind              String // 'membership' | 'platform'
  businessId        String
  payload           Json // level/tier/billing or platform/externalPlanId/billingCycle + expected amount
  status            String   @default("PENDING") // PENDING | DONE | FAILED
  attempts          Int      @default(0)
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
  @@map("payment_outbox")
}

// ─── MCOM PAY — GENERIC APP PAYMENTS LEDGER ─────────────────────────────────
// Any Console-registered app (SsoClient) can charge its customers for anything
// it sells, and MCOM processes the payment (Stripe / PayPal / MCOM wallet).
// Amounts are stored in MINOR units (pence) as BigInt — never floats — so money
// is exact. AppCharge is the header row (attribution + gross/fee/net); the
// double-entry rows live in AppPaymentLedgerEntry (append-only).

enum AppChargeMethod {
  stripe
  paypal
  wallet
}

enum AppChargeStatus {
  pending
  paid
  // Money is moving back to the payer. A claim state: only one refund may hold
  // a charge in `refunding` at a time (compare-and-set), so two concurrent
  // refunds can never both reach the provider.
  refunding
  partially_refunded
  refunded
  failed
  cancelled
}

enum LedgerDirection {
  debit
  credit
}

enum LedgerAccount {
  gateway_clearing
  wallet_clearing
  app_payable
  mcom_revenue
  refund
}

model AppCharge {
  id                   String          @id @default(cuid())
  appClientId          String          @map("app_client_id") // SsoClient.clientId (natural key)
  amountMinor          BigInt          @map("amount_minor") // gross charge, pence
  currency             String          @default("GBP")
  feeMinor             BigInt          @default(0) @map("fee_minor")
  netMinor             BigInt          @map("net_minor") // amountMinor - feeMinor (owed to app)
  refundedMinor        BigInt          @default(0) @map("refunded_minor") // running total; never exceeds amountMinor
  method               AppChargeMethod @map("method")
  status               AppChargeStatus @default(pending)
  reference            String? // app's order/invoice id
  description          String?
  mcomUserId           String?         @map("mcom_user_id") // payer's MCOM identity
  externalCustomerId   String?         @map("external_customer_id") // app's own customer id
  provider             String? // stripe | paypal (card methods only)
  providerRef          String?         @unique @map("provider_ref") // PaymentIntent/order id
  walletDebitAmount    Decimal?        @map("wallet_debit_amount") @db.Decimal(18, 4) // MCOM credits debited (wallet method)
  idempotencyKey       String          @map("idempotency_key") // scoped per app — see @@unique below
  // sha256 of the canonical request payload. A replay carrying the same key but
  // a different amount/method/reference is a conflict, never a silent replay.
  requestHash          String?         @map("request_hash")
  metadata             Json?
  failureReason        String?         @map("failure_reason")
  // Set when the provider moved money but the local settlement write failed.
  // The reconciler (and admins) key off this flag instead of guessing.
  reconciliationNeeded Boolean         @default(false) @map("reconciliation_needed")
  settlementAttempts   Int             @default(0) @map("settlement_attempts")
  paidAt               DateTime?       @map("paid_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  ledgerEntries AppPaymentLedgerEntry[]
  refunds       AppRefund[]

  // Idempotency keys are scoped to the owning app: one partner can no longer
  // burn (or probe) another partner's keys.
  @@unique([appClientId, idempotencyKey])
  @@index([appClientId, createdAt(sort: Desc)])
  @@index([status])
  @@index([mcomUserId])
  @@index([reference])
  @@index([reconciliationNeeded])
  @@map("app_charges")
}

// One row per refund attempt. This is the idempotency record for refunds and
// the source of truth for "how much has already gone back".
model AppRefund {
  id             String    @id @default(cuid())
  chargeId       String    @map("charge_id")
  charge         AppCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  appClientId    String    @map("app_client_id")
  amountMinor    BigInt    @map("amount_minor") // gross refunded back to the payer
  feeRefundMinor BigInt    @default(0) @map("fee_refund_minor")
  netRefundMinor BigInt    @map("net_refund_minor") // amountMinor - feeRefundMinor
  currency       String    @default("GBP")
  provider       String? // stripe | paypal | wallet
  providerRef    String?   @unique @map("provider_ref") // Stripe refund id / PayPal refund id
  status         String    @default("pending") // pending | succeeded | failed
  idempotencyKey String    @map("idempotency_key")
  requestHash    String?   @map("request_hash")
  reason         String?
  failureReason  String?   @map("failure_reason")
  createdBy      String?   @map("created_by") // partner clientId or admin user id
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([appClientId, idempotencyKey])
  @@index([chargeId])
  @@index([status])
  @@index([appClientId, createdAt(sort: Desc)])
  @@map("app_refunds")
}

// Inbound provider webhook dedupe. Unique on (provider, eventId) so a replayed
// delivery is acknowledged with 200 and never re-processed.
model ProcessedWebhookEvent {
  id         String   @id @default(cuid())
  provider   String // stripe | paypal
  eventId    String   @map("event_id")
  eventType  String   @map("event_type")
  chargeId   String?  @map("charge_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@index([chargeId])
  @@index([receivedAt(sort: Desc)])
  @@map("processed_webhook_events")
}

// Durable outbox for every side effect that must survive a crash: partner
// webhook delivery, provider settlement retry, refund reconciliation.
// `dedupeKey` is the idempotency key for the side effect itself.
model AppPaymentOutbox {
  id            String   @id @default(cuid())
  kind          String // partner_webhook | settle_charge | refund_provider
  appClientId   String   @map("app_client_id")
  chargeId      String?  @map("charge_id")
  refundId      String?  @map("refund_id")
  event         String? // payment.succeeded | payment.refunded | ...
  dedupeKey     String   @unique @map("dedupe_key")
  payload       Json
  status        String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([chargeId])
  @@map("app_payment_outbox")
}

model AppPaymentLedgerEntry {
  id             String          @id @default(cuid())
  chargeId       String          @map("charge_id")
  charge         AppCharge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  appClientId    String          @map("app_client_id")
  account        LedgerAccount   @map("account")
  direction      LedgerDirection @map("direction")
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @default("GBP")
  mcomUserId     String?         @map("mcom_user_id")
  provider       String?
  providerRef    String?         @map("provider_ref")
  reference      String?
  metadata       Json?
  idempotencyKey String          @unique @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([chargeId])
  @@index([appClientId, createdAt(sort: Desc)])
  @@index([account])
  @@map("app_payment_ledger_entries")
}

model SsoClient {
  id           String        @id @default(cuid())
  clientId     String        @unique @map("client_id")
  clientSecret String        @map("client_secret")
  name         String
  redirectUris String[]      @map("redirect_uris")
  scopes       String[]
  logoUrl      String?       @map("logo_url")
  apiKey       String?       @unique @map("api_key")
  isActive     Boolean       @default(true) @map("is_active")
  authCodes    SsoAuthCode[]
  ssoSessions  SsoSession[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // ── MCOM CONSOLE FIELDS (additive — safe migration) ─────────────────────
  description      String?   @map("description")
  appUrl           String?   @map("app_url")
  billingApiUrl    String?   @map("billing_api_url")
  hmacSecret       String?   @map("hmac_secret")
  webhookSecret    String?   @map("webhook_secret")
  webhookUrl       String?   @map("webhook_url")
  platformSlug     String?   @unique @map("platform_slug")
  corsOrigins      String[]  @default([]) @map("cors_origins")
  isSystemApp      Boolean   @default(false) @map("is_system_app")
  metadata         Json?     @map("metadata")
  lastWebhookAt    DateTime? @map("last_webhook_at")
  webhookFailCount Int       @default(0) @map("webhook_fail_count")

  // ── MCOM PAY fee config (per-app override; falls back to ProgrammeSetting) ─
  feePercent    Decimal? @map("fee_percent") @db.Decimal(5, 4)
  feeFixedMinor BigInt?  @map("fee_fixed_minor")

  // ── Ecosystem service-to-service identity (M2M, additive) ────────────────
  // Enables a registered app's backend to call another registered app's
  // backend directly (peer-to-peer). MCOM is only the credential issuer and
  // registry; requests never transit MCOM.
  serviceEnabled   Boolean  @default(true) @map("service_enabled")
  serviceBaseUrl   String?  @map("service_base_url")
  serviceScopes    String[] @default([]) @map("service_scopes")
  allowedAudiences String[] @default([]) @map("allowed_audiences")
  allowedCallers   String[] @default([]) @map("allowed_callers")

  // ── White-label access (additive) ───────────────────────────────────────
  // When true, this platform only admits businesses that an admin has
  // explicitly granted white-label access to. It bypasses membership and
  // access-pass checks entirely (grant = immediate dashboard access).
  allowWhitelabel  Boolean            @default(false) @map("allow_whitelabel")
  whitelabelAccess WhitelabelAccess[]

  @@index([clientId])
  @@index([apiKey])
  @@index([platformSlug])
  @@index([isActive])
  @@index([allowWhitelabel])
  @@map("sso_clients")
}

// Per-business white-label grant. A row means "this business may SSO into this
// white-label platform", independent of membership tier, packages or access
// passes. Business-only by design: only BusinessProfile can own a grant.
model WhitelabelAccess {
  id         String          @id @default(cuid())
  businessId String          @map("business_id")
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String          @map("client_id")
  client     SsoClient       @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  grantedBy  String?         @map("granted_by")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@unique([businessId, clientId])
  @@index([businessId])
  @@index([clientId])
  @@map("whitelabel_accesses")
}

// Audit trail for issued ecosystem service tokens (control-plane traceability).
// FK-free by design: tokens outlive/relate to clients by natural key and must
// survive client deletion. Append-only.
model ServiceTokenAudit {
  id        String   @id @default(cuid())
  jti       String   @unique @map("jti")
  tokenType String   @map("token_type") // "service" | "delegated"
  clientId  String   @map("client_id") // caller app (sub for service, act.sub for delegated)
  subject   String?  @map("subject") // end-user id for delegated tokens
  audience  String?  @map("audience")
  scopes    String[] @default([])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([createdAt])
  @@map("service_token_audit")
}

model AppWebhookLog {
  id           String    @id @default(cuid())
  // Phase 5: intentionally FK-free. Append-only delivery log keyed by the
  // client's natural key (SsoClient.clientId string, not its cuid id) —
  // logs must survive client deletion, and a restrictive FK would block it.
  clientId     String    @map("client_id")
  event        String    @map("event")
  payload      Json      @map("payload")
  statusCode   Int?      @map("status_code")
  responseBody String?   @map("response_body")
  deliveredAt  DateTime? @map("delivered_at")
  failed       Boolean   @default(false) @map("failed")
  jobId        String?   @map("job_id")
  retryCount   Int       @default(0) @map("retry_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([clientId])
  @@index([createdAt])
