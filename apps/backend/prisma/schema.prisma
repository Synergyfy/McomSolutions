  @@map("readiness_gates")
}

model BusinessProgramme {
  id                 String                @id @default(cuid())
  // Phase 5: intentionally FK-free. Enrolments snapshot business/agent names
  // and tolerate dangling ids when a business is soft-deleted (the programme
  // history must outlive the profile). Resolved in code with null-tolerance.
  businessId         String?               @map("business_id")
  businessName       String                @map("business_name")
  sector             String                @map("sector")
  currentDay         Int                   @default(1) @map("current_day")
  status             ProgrammeStatus       @default(active) @map("status")
  agentId            String?               @map("agent_id")
  agentName          String                @map("agent_name")
  accountManagerId   String?               @map("account_manager_id")
  accountManagerName String                @map("account_manager_name")
  consultantId       String?               @map("consultant_id")
  consultantName     String                @map("consultant_name")
  completedMissions  String[]              @map("completed_missions")
  startedAt          DateTime              @default(now()) @map("started_at")
  extendedBy         Int                   @default(0) @map("extended_by")
  phaseId            String?               @map("phase_id")
  phase              ProgrammePhase?       @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  taskStatuses       ProgrammeTaskStatus[]
  deletedAt          DateTime?             @map("deleted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([agentId])
  @@index([status])
  @@index([phaseId])
  @@index([deletedAt])
  @@map("business_programmes")
