// ─── PROGRAMME MANAGEMENT (ProgrammeManagementPanel) ────────────────────────

enum ProgrammeStatus {
  active
  paused
  completed
  extended
}

enum SubmissionType {
  internal_platform
  external_link
  image_upload
  text_input
  digit_input
}

enum TaskStatus {
  not_started
  in_progress
  completed
}

model ProgrammePhase {
  id          String            @id @default(cuid())
  name        String            @map("name")
  dayStart    Int               @map("day_start")
  dayEnd      Int               @map("day_end")
  description String            @map("description")
  color       String            @default("sky") @map("color")
  order       Int               @default(0) @map("order")
  missions    Json              @map("missions")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  businesses  BusinessProgramme[]

  @@index([order])
  @@map("programme_phases")
}

model ReadinessGate {
  id                String   @id @default(cuid())
  name              String   @map("name")
  minProgressPercent Int     @map("min_progress_percent")
  isEnabled         Boolean  @default(true) @map("is_enabled")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("readiness_gates")
}

model BusinessProgramme {
  id                  String            @id @default(cuid())
  businessId          String?           @map("business_id")
  businessName        String            @map("business_name")
  sector              String            @map("sector")
  currentDay          Int               @default(1) @map("current_day")
  status              ProgrammeStatus   @default(active) @map("status")
  agentId             String?           @map("agent_id")
  agentName           String            @map("agent_name")
  accountManagerId    String?           @map("account_manager_id")
  accountManagerName  String            @map("account_manager_name")
  consultantId        String?           @map("consultant_id")
  consultantName      String            @map("consultant_name")
  completedMissions   String[]          @map("completed_missions")
  startedAt           DateTime          @default(now()) @map("started_at")
  extendedBy          Int               @default(0) @map("extended_by")
  phaseId             String?           @map("phase_id")
  phase               ProgrammePhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  taskStatuses        ProgrammeTaskStatus[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([agentId])
  @@index([status])
  @@index([phaseId])
  @@map("business_programmes")
}

model ProgrammeTaskStatus {
  id                   String          @id @default(cuid())
  businessProgrammeId  String          @map("business_programme_id")
  businessProgramme    BusinessProgramme @relation(fields: [businessProgrammeId], references: [id], onDelete: Cascade)
  missionId            String          @map("mission_id")
  status               TaskStatus      @default(not_started) @map("status")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@unique([businessProgrammeId, missionId])
  @@index([businessProgrammeId])
  @@map("programme_task_statuses")
}

enum SupportAgentRole {
  agent
  account_manager
  consultant
}

model SupportAgent {
  id        String          @id @default(cuid())
  name      String          @map("name")
  role      SupportAgentRole @map("role")
  email     String          @unique @map("email")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([role])
  @@map("support_agents")
}

// ─── ASSESSMENT (AssessmentPanel) ────────────────────────────────────────────

enum AssessmentFieldType {
  single_choice
  multi_choice
  text
  textarea
  number
  date
  rating
  yes_no
}

model AssessmentQuestion {
  id        String              @id @default(cuid())
  question  String              @map("question")
  iconName  String              @map("icon_name")
  fieldType AssessmentFieldType @map("field_type")
  options   String[]            @map("options")
  hint      String              @map("hint")
  enabled   Boolean             @default(true) @map("enabled")
  order     Int                 @default(0) @map("order")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@index([order])
  @@map("assessment_questions")
}

// ─── ACTIVITY FEED (HighStreetsPanel operational feed) ───────────────────────

enum ActivitySeverity {
  info
  success
  warning
  danger
}

model ActivityFeed {
  id          String           @id @default(cuid())
  type        String           @map("type")
  title       String           @map("title")
  details     String?          @map("details")
  location    String?          @map("location")
  severity    ActivitySeverity @default(info) @map("severity")
  source      String?          @map("source")
  highStreetId String?         @map("high_street_id")
  highStreet  HighStreet?      @relation(fields: [highStreetId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([highStreetId])
  @@index([type])
  @@index([createdAt])
  @@map("activity_feed")
}

// ─── BOROUGH METRICS (BoroughsPanel detail stats) ────────────────────────────

model BoroughMetric {
  id             String   @id @default(cuid())
  boroughId      String   @map("borough_id")
  borough        Borough  @relation(fields: [boroughId], references: [id], onDelete: Cascade)
  month          String   @map("month") // YYYY-MM
  footfall       Int      @default(0) @map("footfall")
  revenue        Float    @default(0) @map("revenue")
  activeCustomers Int     @default(0) @map("active_customers")
  businesses     Int      @default(0) @map("businesses")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([boroughId, month])
  @@index([boroughId])
  @@index([month])
  @@map("borough_metrics")
}

// ─── SYSTEM DEVELOPER CENTER (SystemPanel) ───────────────────────────────────

model BackgroundJob {
  id          String   @id @default(cuid())
  name        String   @map("name")
  status      String   @default("pending") @map("status") // pending, running, completed, failed
  progress    Int      @default(0) @map("progress")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  error       String?  @map("error")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("background_jobs")
}

model ErrorLog {
  id        String   @id @default(cuid())
  level     String   @default("error") @map("level") // error, warn, info
  message   String   @map("message")
  stack     String?  @map("stack")
  source    String?  @map("source")
  path      String?  @map("path")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([level])
  @@index([createdAt])
  @@map("error_logs")
}

// ─── CAMPAIGNS (HighStreetsPanel / BoroughsPanel) ────────────────────────────

enum CampaignStatus {
  active
  paused
  completed
  draft
}

model Campaign {
  id           String         @id @default(cuid())
  name         String         @map("name")
  description  String?        @map("description")
  locationType String         @map("location_type") // high_street | borough | local_mall
  locationId   String?        @map("location_id")
  locationName String?        @map("location_name")
  status       CampaignStatus @default(draft) @map("status")
  startDate    DateTime?      @map("start_date")
  endDate      DateTime?      @map("end_date")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([locationType])
  @@index([status])
  @@index([locationId])
  @@map("campaigns")
}

// ─── CENTRALIZED WALLET SYSTEM ────────────────────────────────────────────────

enum WalletStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionCategory {
  TOP_UP
  REWARD
  REFUND
  ADMIN_CREDIT
  TRANSFER_IN
  SUBSCRIPTION
  PURCHASE
  SERVICE_FEE
  ADMIN_DEBIT
  TRANSFER_OUT
  HOLD_CAPTURE
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REVERSED
}

enum HoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

enum TopUpStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Wallet {
  id                 String        @id @default(cuid())
  userId             String        @unique @map("user_id")
  balance            Decimal       @default(0) @db.Decimal(18, 4) @map("balance")
  currency           String        @default("MCOM") @map("currency")
  status             WalletStatus  @default(ACTIVE) @map("status")

  dailyDebitLimit    Decimal?      @db.Decimal(18, 4) @map("daily_debit_limit")
  monthlyDebitLimit  Decimal?      @db.Decimal(18, 4) @map("monthly_debit_limit")
  maxBalance         Decimal?      @db.Decimal(18, 4) @map("max_balance")

  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  lastTransactionAt  DateTime?     @map("last_transaction_at")

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       WalletTransaction[]
  holds              WalletHold[]
  topUpRequests      WalletTopUpRequest[]
  auditLogs          WalletAuditLog[]

  @@index([userId])
  @@index([status])
  @@map("wallets")
}

model WalletTransaction {
  id                String              @id @default(cuid())
  walletId          String              @map("wallet_id")

  type              TransactionType     @map("type")
  amount            Decimal             @db.Decimal(18, 4) @map("amount")
  balanceBefore     Decimal             @db.Decimal(18, 4) @map("balance_before")
  balanceAfter      Decimal             @db.Decimal(18, 4) @map("balance_after")
  currency          String              @default("MCOM") @map("currency")

  platformClientId  String?             @map("platform_client_id")
  platformName      String?             @map("platform_name")
  platformSlug      String?             @map("platform_slug")

  category          TransactionCategory @map("category")
  reference         String?             @map("reference")
  description       String?             @map("description")
  metadata          Json?               @map("metadata")

  idempotencyKey    String?             @unique @map("idempotency_key")

  status            TransactionStatus   @default(COMPLETED) @map("status")
  failureReason     String?             @map("failure_reason")
  holdId            String?             @map("hold_id")
  initiatedBy       String?             @map("initiated_by")
  ipAddress         String?             @map("ip_address")

  createdAt         DateTime            @default(now()) @map("created_at")

  wallet            Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  hold              WalletHold?         @relation(fields: [holdId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([walletId, createdAt(sort: Desc)])
  @@index([platformClientId])
  @@index([platformSlug])
  @@index([category])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([idempotencyKey])
  @@index([reference])
  @@index([status])
  @@index([walletId, platformSlug, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model WalletHold {
  id               String     @id @default(cuid())
  walletId         String     @map("wallet_id")
  amount           Decimal    @db.Decimal(18, 4) @map("amount")
  platformClientId String     @map("platform_client_id")
  platformName     String     @map("platform_name")
  reference        String?    @map("reference")
  description      String?    @map("description")
  status           HoldStatus @default(ACTIVE) @map("status")
  expiresAt        DateTime   @map("expires_at")
  capturedAt       DateTime?  @map("captured_at")
  releasedAt       DateTime?  @map("released_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  wallet       Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([walletId])
  @@index([platformClientId])
  @@index([expiresAt])
  @@index([status])
  @@map("wallet_holds")
}

model WalletAuditLog {
  id        String   @id @default(cuid())
  walletId  String   @map("wallet_id")
  adminId   String   @map("admin_id")
  action    String   @map("action")
  reason    String   @map("reason")
  changes   Json?    @map("changes")
  ip        String?  @map("ip")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([adminId])
  @@index([createdAt(sort: Desc)])
  @@map("wallet_audit_logs")
}

model WalletTopUpRequest {
  id             String     @id @default(cuid())
  walletId       String     @map("wallet_id")
  userId         String     @map("user_id")
  amount         Decimal    @db.Decimal(18, 4) @map("amount")
  currency       String     @default("GBP") @map("currency")
  walletCurrency String     @default("MCOM") @map("wallet_currency")
  exchangeRate   Decimal    @default(1) @db.Decimal(10, 6) @map("exchange_rate")

  provider       String     @map("provider")
  providerRef    String?    @unique @map("provider_ref")
  providerStatus String?    @map("provider_status")

  status         TopUpStatus @default(PENDING) @map("status")
  transactionId  String?    @map("transaction_id")

  createdAt      DateTime   @default(now()) @map("created_at")
  completedAt    DateTime?  @map("completed_at")

  wallet         Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([providerRef])
  @@index([status])
  @@map("wallet_top_up_requests")
}

// ─── FX RATES (wallet top-up conversion) ────────────────────────────────────
// Base → quote pair, seeded from env (MCOM_GBP_RATE) and updatable at runtime.

model FxRate {
  id        String   @id @default(cuid())
  base      String   @map("base")     // e.g. 'GBP'
  quote     String   @map("quote")    // e.g. 'MCOM'
  rate      Decimal  @db.Decimal(10, 6) @map("rate")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([base, quote])
  @@map("fx_rates")
}
