enum ProgrammeStatus {
  active
  paused
  completed
  extended
}

enum SubmissionType {
  internal_platform
  external_link
  image_upload
  text_input
  digit_input
}

enum TaskStatus {
  not_started
  in_progress
  completed
}

model ProgrammePhase {
  id          String              @id @default(cuid())
