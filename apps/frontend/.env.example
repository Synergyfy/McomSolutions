# ─── MCOM Solutions Frontend — Environment Template ─────────────────────────
# Copy to .env and fill in real values. NEVER commit real secrets.
# NOTE: Google Maps key must be restricted by HTTP referrer in the Google
# Cloud console (Phase 7) — never ship an unrestricted key.

# Backend base URL (falls back to /api/v1 when unset).
VITE_API_URL="http://localhost:3010/api/v1"
VITE_BACKEND_URL="http://localhost:3010"

# Ecosystem links (fallbacks live in code: mall :3003, loyalty :3005).
VITE_MCOM_MALL_URL="http://localhost:3003"
VITE_MCOM_LOYALTY_URL="http://localhost:3005"
VITE_AFFILIATE_PORTAL_URL="http://localhost:7089"
# Production: VITE_AFFILIATE_PORTAL_URL="https://247gbsaffiliates.centralhubsolution.com"
VITE_AFFILIATE_SSO_URL="http://localhost:7088/api/v1/auth/sso/callback"

# Stripe publishable key (test key in dev/staging).
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Google Maps (restrict by referrer; see note above).
VITE_GOOGLE_MAPS_API_KEY=""
